#Область РасширениеСобытийТиповойФормы

&НаСервере
&После("ПриСозданииНаСервере")
Процедура Расш1_ТЛПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	Расш1_ФормаСпецификацииТЛСервер.ДобавитьЭлементы(ЭтотОбъект);
	Расш1_ТЛПрочитатьРедакцию();
КонецПроцедуры

&НаСервере
&После("ПриЧтенииНаСервере")
Процедура Расш1_ТЛПриЧтенииНаСервере(ТекущийОбъект)
	Расш1_ФормаСпецификацииТЛСервер.ДобавитьЭлементы(ЭтотОбъект);
	Расш1_ТЛПрочитатьРедакцию();
КонецПроцедуры

&НаСервере
&После("ПередЗаписьюНаСервере")
Процедура Расш1_ТЛПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Если Отказ ИЛИ НЕ ТекущийОбъект.Расш1_ЭтоТехническийЛист Тогда
		Возврат;
	КонецЕсли;
	Лист = Расш1_ТЛДанныеДляИзменения(Ложь);
	// Здесь ещё нет отдельной записи техлиста: его сохранит подписка внутри
	// транзакции записи спецификации. Отказ УНФ откатит оба объекта.
	ТекущийОбъект.ДополнительныеСвойства.Вставить("Расш1_ДанныеТЛ", Лист);
	ТекущийОбъект.ДополнительныеСвойства.Вставить("Расш1_ПрочитанноеСостояниеТЛ",
		ЭтотОбъект["Расш1_ПрочитанноеСостояниеТЛ"]);
КонецПроцедуры

&НаСервере
&После("ПослеЗаписиНаСервере")
Процедура Расш1_ТЛПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	Объект.Расш1_ТехническийЛист = ТекущийОбъект.Расш1_ТехническийЛист;
	Расш1_ТЛПрочитатьРедакцию();
	// Главный реквизит обновляет штатная запись формы. Здесь не запускается
	// новый расчёт после уже успешной записи и не заменяются колонки формы.
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиЭлементовИКоманд

&НаКлиенте
Процедура Расш1_ТЛФлажокПриИзменении(Элемент)
	Расш1_ТЛИзменитьФлажокНаСервере();
	Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ТЛРедакцияПриИзменении(Элемент)
	Если ЭтотОбъект["Расш1_ИзмененТЛ"] Тогда
		Объект.Расш1_ТехническийЛист = ЭтотОбъект["Расш1_ОткрытаяРедакцияТЛ"];
		ПоказатьПредупреждение(, "Сохраните изменения техлиста перед выбором другой редакции.");
		Возврат;
	КонецЕсли;
	Расш1_ТЛЗаменитьРедакциюНаСервере();
	Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ТЛПараметрыПриИзменении(Элемент)
	Если Элемент.Имя = "Расш1_ТЛКолонкаОперацииОперация" Тогда
		СтрокаОперации = Элементы.Расш1_ТЛТаблицаОперации.ТекущиеДанные;
		Если СтрокаОперации <> Неопределено Тогда
			Данные = Расш1_ТЛДанныеОперацииНаСервере(СтрокаОперации.Операция);
			СтрокаОперации.Участок = Данные.Участок;
			СтрокаОперации.РаботаУНФ = Данные.РаботаУНФ;
			СтрокаОперации.НормаВремениМин = Данные.НормаВремениМин;
		КонецЕсли;
	КонецЕсли;
	ЭтотОбъект["Расш1_ИзмененТЛ"] = Истина;
	Модифицированность = Истина;
	Расш1_ТЛПересчитатьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ТЛТаблицаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НЕ НоваяСтрока ИЛИ Элемент.Имя = "Расш1_ТЛТаблицаРучныеМатериалы" Тогда
		Возврат;
	КонецЕсли;
	СтрокаТаблицы = Элемент.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтрокаТаблицы.Идентификатор = Строка(Новый УникальныйИдентификатор);
	Если НЕ Копирование Тогда
		Если Элемент.Имя = "Расш1_ТЛТаблицаОперации" Тогда
			СтрокаТаблицы.Использовать = Истина;
		ИначеЕсли Элемент.Имя = "Расш1_ТЛТаблицаСлоиПечати" Тогда
			СтрокаТаблицы.Использовать = Истина;
			СтрокаТаблицы.ПроцентНанесения = 100;
		ИначеЕсли Элемент.Имя = "Расш1_ТЛТаблицаОтверстия" ИЛИ Элемент.Имя = "Расш1_ТЛТаблицаКоннекторы" Тогда
			СтрокаТаблицы.Количество = 1;
		КонецЕсли;
	КонецЕсли;
	ЭтотОбъект["Расш1_ИзмененТЛ"] = Истина;
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ТЛПересчитать(Команда)
	ЭтотОбъект["Расш1_ИзмененТЛ"] = Истина;
	Модифицированность = Истина;
	Расш1_ТЛПересчитатьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ТЛУтвердить(Команда)
	Попытка
		Расш1_ТЛПодготовитьУтверждение();
		Если НЕ Записать() Тогда
			Расш1_ТЛВернутьЧерновик();
		КонецЕсли;
	Исключение
		Расш1_ТЛВернутьЧерновик();
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ТЛНоваяРедакция(Команда)
	Если Модифицированность Тогда
		ПоказатьПредупреждение(, "Сохраните спецификацию перед созданием следующей редакции.");
		Возврат;
	КонецЕсли;
	Расш1_ТЛСоздатьРедакциюНаСервере();
	Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ТЛОткрытьКарточку(Команда)
	Если ЭтотОбъект["Расш1_ИзмененТЛ"] ИЛИ НЕ ЗначениеЗаполнено(Объект.Расш1_ТехническийЛист) Тогда
		ПоказатьПредупреждение(, "Сначала сохраните спецификацию с техническим листом.");
		Возврат;
	КонецЕсли;
	ОткрытьФорму("Справочник.Расш1_ТехническиеЛисты.Форма.ФормаЭлемента",
		Новый Структура("Ключ", Объект.Расш1_ТехническийЛист));
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ТЛПечать(Команда)
	Если Модифицированность ИЛИ НЕ ЗначениеЗаполнено(Объект.Расш1_ТехническийЛист) Тогда
		ПоказатьПредупреждение(, "Сохраните спецификацию с техническим листом перед печатью.");
		Возврат;
	КонецЕсли;
	ПечатнаяФорма = Расш1_ТЛПечатнаяФормаНаСервере(Объект.Расш1_ТехническийЛист);
	ПечатнаяФорма.Показать("Технический лист");
КонецПроцедуры

&НаКлиенте
Асинх Процедура Расш1_ТЛПрикрепитьФайл(Команда)
	Попытка
		ОписаниеФайла = Ждать ПоместитьФайлНаСерверАсинх(,,,, УникальныйИдентификатор);
		Если ОписаниеФайла = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Файл = Новый Файл(ОписаниеФайла.СсылкаНаФайл.Имя);
		Расш1_ТЛДобавитьФайлНаСервере(ОписаниеФайла.Адрес, Файл.Имя);
		ЭтотОбъект["Расш1_ИзмененТЛ"] = Истина;
		Модифицированность = Истина;
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Асинх Процедура Расш1_ТЛСохранитьФайл(Команда)
	СтрокаФайла = Элементы.Расш1_ТЛТаблицаФайлы.ТекущиеДанные;
	Если СтрокаФайла = Неопределено Тогда
		ПоказатьПредупреждение(, "Выберите вложение на вкладке файлов.");
		Возврат;
	КонецЕсли;
	Попытка
		Адрес = Расш1_ТЛАдресФайлаНаСервере(СтрокаФайла.Идентификатор);
		Ждать ПолучитьФайлССервераАсинх(Адрес, СтрокаФайла.ИмяФайла);
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

#Область СервернаяРаботаСДанными

&НаСервере
Процедура Расш1_ТЛПрочитатьРедакцию()
	Если ЗначениеЗаполнено(Объект.Расш1_ТехническийЛист) Тогда
		Лист = Объект.Расш1_ТехническийЛист.ПолучитьОбъект();
		Если Лист = Неопределено ИЛИ Лист.ПометкаУдаления Тогда
			ВызватьИсключение "Редакция технического листа удалена или недоступна.";
		КонецЕсли;
	Иначе
		Лист = Справочники.Расш1_ТехническиеЛисты.СоздатьЭлемент();
		Расш1_ТехническиеЛистыСервер.ПодготовитьНовый(Лист);
		Лист.Номенклатура = Объект.Владелец;
		Лист.Характеристика = Объект.ХарактеристикаПродукции;
		Лист.Наименование = Объект.Наименование;
	КонецЕсли;
	ЗначениеВРеквизитФормы(Лист, "Расш1_ДанныеТЛ");
	ЭтотОбъект["Расш1_ОткрытаяРедакцияТЛ"] = Объект.Расш1_ТехническийЛист;
	ЭтотОбъект["Расш1_ИзмененТЛ"] = Ложь;
	ЭтотОбъект["Расш1_ПрочитанноеСостояниеТЛ"] = Лист.Состояние;
	ЭтотОбъект["Расш1_СообщениеТЛ"] = ?(Лист.Состояние = Перечисления.Расш1_СостоянияТЛ.Утвержден,
		"Утверждённая редакция. Для изменения создайте следующую редакцию.",
		"Черновик. Параметры и состав сохраняются вместе со спецификацией.");
	Расш1_ФормаСпецификацииТЛСервер.ОбновитьДоступность(ЭтотОбъект, Лист);
КонецПроцедуры

&НаСервере
Функция Расш1_ТЛДанныеДляИзменения(ПроверятьЧерновик = Истина)
	Расш1_ТехническиеЛистыСервер.ПроверитьПравоРедактирования();
	Если ЭтотОбъект["Расш1_ОткрытаяРедакцияТЛ"] <> Объект.Расш1_ТехническийЛист Тогда
		ВызватьИсключение "На вкладке открыта другая редакция. Выберите редакцию повторно или перечитайте спецификацию.";
	КонецЕсли;
	Лист = РеквизитФормыВЗначение("Расш1_ДанныеТЛ");
	Если ПроверятьЧерновик И Лист.Состояние <> Перечисления.Расш1_СостоянияТЛ.Черновик Тогда
		ВызватьИсключение "Утверждённая редакция не изменяется. Создайте следующую редакцию.";
	КонецЕсли;
	Если Лист.ЭтоНовый() Тогда
		Лист.Номенклатура = Объект.Владелец;
		Лист.Характеристика = Объект.ХарактеристикаПродукции;
		Лист.Наименование = Объект.Наименование;
	КонецЕсли;
	Возврат Лист;
КонецФункции

&НаСервере
Процедура Расш1_ТЛПересчитатьНаСервере()
	Лист = Расш1_ТЛДанныеДляИзменения();
	ЭтотОбъект["Расш1_СообщениеТЛ"] = Расш1_ТехническиеЛистыСервер.Пересчитать(Лист);
	ЗначениеВРеквизитФормы(Лист, "Расш1_ДанныеТЛ");
	Если НЕ ПустаяСтрока(Лист.ОшибкиРасчета) Тогда
		Возврат;
	КонецЕсли;
	Расш1_СпецификацииТЛСервер.Синхронизировать(Объект, Лист);
КонецПроцедуры

&НаСервере
Процедура Расш1_ТЛИзменитьФлажокНаСервере()
	Расш1_ТехническиеЛистыСервер.ПроверитьПравоРедактирования();
	Лист = РеквизитФормыВЗначение("Расш1_ДанныеТЛ");
	Если Объект.Расш1_ЭтоТехническийЛист Тогда
		Если Лист.Состояние = Перечисления.Расш1_СостоянияТЛ.Черновик Тогда
			Расш1_ТЛПересчитатьНаСервере();
		Иначе
			Расш1_СпецификацииТЛСервер.Синхронизировать(Объект, Лист);
		КонецЕсли;
	Иначе
		Расш1_СпецификацииТЛСервер.Синхронизировать(Объект, Неопределено);
	КонецЕсли;
	Расш1_ФормаСпецификацииТЛСервер.ОбновитьДоступность(ЭтотОбъект, Лист);
КонецПроцедуры

&НаСервере
Процедура Расш1_ТЛЗаменитьРедакциюНаСервере()
	Расш1_ТехническиеЛистыСервер.ПроверитьПравоРедактирования();
	Прежняя = ЭтотОбъект["Расш1_ОткрытаяРедакцияТЛ"];
	Попытка
		Если ЗначениеЗаполнено(Объект.Расш1_ТехническийЛист) Тогда
			Лист = Объект.Расш1_ТехническийЛист.ПолучитьОбъект();
			Если Лист = Неопределено ИЛИ Лист.ПометкаУдаления Тогда
				ВызватьИсключение "Выберите действующую редакцию технического листа.";
			КонецЕсли;
			Расш1_СпецификацииТЛСервер.ПроверитьИзделие(Объект, Лист);
			Расш1_СпецификацииТЛСервер.Синхронизировать(Объект, Лист);
		Иначе
			Лист = Расш1_СпецификацииТЛСервер.НовыйЛистСпецификации(Объект);
			Расш1_СпецификацииТЛСервер.Синхронизировать(Объект, Лист);
		КонецЕсли;
		Расш1_ТЛПрочитатьРедакцию();
	Исключение
		Объект.Расш1_ТехническийЛист = Прежняя;
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура Расш1_ТЛПодготовитьУтверждение()
	Лист = Расш1_ТЛДанныеДляИзменения();
	Лист.Состояние = Перечисления.Расш1_СостоянияТЛ.Утвержден;
	ЗначениеВРеквизитФормы(Лист, "Расш1_ДанныеТЛ");
КонецПроцедуры

&НаСервере
Процедура Расш1_ТЛВернутьЧерновик()
	Лист = РеквизитФормыВЗначение("Расш1_ДанныеТЛ");
	Если ЗначениеЗаполнено(Лист.Ссылка) И Лист.Ссылка.Состояние = Перечисления.Расш1_СостоянияТЛ.Утвержден Тогда
		Расш1_ТЛПрочитатьРедакцию();
		Возврат;
	КонецЕсли;
	Лист.Состояние = Перечисления.Расш1_СостоянияТЛ.Черновик;
	ЗначениеВРеквизитФормы(Лист, "Расш1_ДанныеТЛ");
	Расш1_ФормаСпецификацииТЛСервер.ОбновитьДоступность(ЭтотОбъект, Лист);
КонецПроцедуры

&НаСервере
Процедура Расш1_ТЛСоздатьРедакциюНаСервере()
	НоваяСсылка = Расш1_ТехническиеЛистыСервер.СоздатьРедакцию(Объект.Расш1_ТехническийЛист);
	Объект.Расш1_ТехническийЛист = НоваяСсылка;
	Расш1_ТЛПрочитатьРедакцию();
	Расш1_СпецификацииТЛСервер.Синхронизировать(Объект, НоваяСсылка.ПолучитьОбъект());
КонецПроцедуры

&НаСервереБезКонтекста
Функция Расш1_ТЛДанныеОперацииНаСервере(Знач Операция)
	Возврат Расш1_ТехническиеЛистыСервер.ДанныеОперации(Операция);
КонецФункции

&НаСервереБезКонтекста
Функция Расш1_ТЛПечатнаяФормаНаСервере(Знач Ссылка)
	Возврат Расш1_ПечатьТЛСервер.Сформировать(Ссылка);
КонецФункции

&НаСервере
Процедура Расш1_ТЛДобавитьФайлНаСервере(Знач Адрес, Знач ИмяФайла)
	Лист = Расш1_ТЛДанныеДляИзменения();
	Данные = ПолучитьИзВременногоХранилища(Адрес);
	Если ТипЗнч(Данные) <> Тип("ДвоичныеДанные") Тогда
		ВызватьИсключение "Не удалось получить содержимое файла.";
	КонецЕсли;
	Если Данные.Размер() > 20971520 Тогда
		ВызватьИсключение "Размер одного вложения не должен превышать 20 МБ.";
	КонецЕсли;
	Вложение = Лист.Файлы.Добавить();
	Вложение.Идентификатор = Строка(Новый УникальныйИдентификатор);
	Вложение.ИмяФайла = ИмяФайла;
	Вложение.Наименование = ИмяФайла;
	Вложение.Данные = Новый ХранилищеЗначения(Данные, Новый СжатиеДанных(6));
	ЗначениеВРеквизитФормы(Лист, "Расш1_ДанныеТЛ");
	УдалитьИзВременногоХранилища(Адрес);
КонецПроцедуры

&НаСервере
Функция Расш1_ТЛАдресФайлаНаСервере(Знач Идентификатор)
	Лист = РеквизитФормыВЗначение("Расш1_ДанныеТЛ");
	Вложение = Лист.Файлы.Найти(Идентификатор, "Идентификатор");
	Если Вложение = Неопределено ИЛИ Вложение.Данные = Неопределено Тогда
		ВызватьИсключение "У выбранной строки нет сохранённого вложения.";
	КонецЕсли;
	Данные = Вложение.Данные.Получить();
	Если Данные = Неопределено Тогда
		ВызватьИсключение "Содержимое вложения отсутствует.";
	КонецЕсли;
	Возврат ПоместитьВоВременноеХранилище(Данные, УникальныйИдентификатор);
КонецФункции

#КонецОбласти
