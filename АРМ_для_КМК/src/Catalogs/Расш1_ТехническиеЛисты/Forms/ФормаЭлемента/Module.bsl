#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Лист = РеквизитФормыВЗначение("Объект");
	Расш1_ТехническиеЛистыСервер.ПодготовитьНовый(Лист);
	ЗначениеВРеквизитФормы(Лист, "Объект");
	НастроитьФорматЛиста();
	Если Лист.Состояние = Перечисления.Расш1_СостоянияТЛ.Черновик
		И ЗначениеЗаполнено(Лист.Номенклатура)
		И Расш1_ТехническиеЛистыСервер.МожноРедактировать() Тогда
		ПересчитатьНаСервере();
	КонецЕсли;
	НастроитьДоступность();
	ОбновитьЯчейкиЛиста();
	ОбновитьИзображенияЛиста();
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	СообщениеРасчета = ТекущийОбъект.ОшибкиРасчета;
	НастроитьДоступность();
	ОбновитьЯчейкиЛиста();
	ОбновитьИзображенияЛиста();
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	ЗначениеВРеквизитФормы(ТекущийОбъект, "Объект");
	СообщениеРасчета = ?(ПустаяСтрока(ТекущийОбъект.ОшибкиРасчета),
		"Технический лист записан.", "Черновик записан. Ошибки расчёта: " + ТекущийОбъект.ОшибкиРасчета);
	НастроитьДоступность();
	ОбновитьЯчейкиЛиста();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПараметрыПриИзменении(Элемент)
	Если Элемент.Имя = "Файлы" Тогда
		ОбновитьИзображенияНаСервере();
		Модифицированность = Истина;
		Возврат;
	КонецЕсли;
	Если Элемент.Имя = "ОперацииОперация" Тогда
		СтрокаОперации = Элементы.Операции.ТекущиеДанные;
		Если СтрокаОперации <> Неопределено Тогда
			Данные = ДанныеОперацииНаСервере(СтрокаОперации.Операция);
			СтрокаОперации.Участок = Данные.Участок;
			СтрокаОперации.РаботаУНФ = Данные.РаботаУНФ;
			СтрокаОперации.НормаВремениМин = Данные.НормаВремениМин;
		КонецЕсли;
	КонецЕсли;
	ПересчитатьНаСервере();
	Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ЯчейкаЛистаПриИзменении(Элемент)
	ИзменитьЯчейкуЛистаНаСервере(Элемент.Имя);
	Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ИзображениеЛистаПриИзменении(Элемент)
	ОбновитьИзображенияНаСервере();
	Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НЕ НоваяСтрока Тогда
		Возврат;
	КонецЕсли;
	СтрокаТаблицы = Элемент.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено ИЛИ Элемент.Имя = "РучныеМатериалы" Тогда
		Возврат;
	КонецЕсли;
	СтрокаТаблицы.Идентификатор = Строка(Новый УникальныйИдентификатор);
	Если НЕ Копирование Тогда
		Если Элемент.Имя = "Операции" Тогда
			СтрокаТаблицы.Использовать = Истина;
		ИначеЕсли Элемент.Имя = "СлоиПечати" Тогда
			СтрокаТаблицы.Использовать = Истина;
			СтрокаТаблицы.ПроцентНанесения = 100;
		ИначеЕсли Элемент.Имя = "Отверстия" ИЛИ Элемент.Имя = "Коннекторы" Тогда
			СтрокаТаблицы.Количество = 1;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьМатериалы(Команда)
	ПересчитатьНаСервере();
	Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура Утвердить(Команда)
	Попытка
		УтвердитьНаСервере();
		Модифицированность = Ложь;
		Оповестить("Расш1_ТехЛистЗаписан", Объект.Ссылка, ЭтотОбъект);
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура НоваяРедакция(Команда)
	Если Модифицированность ИЛИ НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПоказатьПредупреждение(, "Сначала сохраните и утвердите исходный технический лист.");
		Возврат;
	КонецЕсли;
	НовыйЛист = СоздатьРедакциюНаСервере(Объект.Ссылка);
	ОткрытьКарточку(НовыйЛист);
КонецПроцедуры

&НаКлиенте
Процедура ИндивидуальныйЛист(Команда)
	Если Модифицированность ИЛИ НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПоказатьПредупреждение(, "Сначала сохраните и утвердите исходный технический лист.");
		Возврат;
	КонецЕсли;
	ПоказатьВводЗначения(Новый ОписаниеОповещения("ЗаказДляИндивидуальногоЛистаВыбран", ЭтотОбъект, Объект.Ссылка),
		Неопределено, "Заказ для индивидуального технического листа", Новый ОписаниеТипов("ДокументСсылка.ЗаказНаПроизводство"));
КонецПроцедуры

&НаКлиенте
Процедура ЗаказДляИндивидуальногоЛистаВыбран(Результат, ИсходныйТехЛист) Экспорт
	Если Результат = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;
	СписокСтрок = СтрокиЗаказаНаСервере(Результат);
	Если СписокСтрок.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "В выбранном заказе нет строк продукции.");
		Возврат;
	КонецЕсли;
	ПараметрыВыбора = Новый Структура("Заказ,ИсходныйТехЛист", Результат, ИсходныйТехЛист);
	СписокСтрок.ПоказатьВыборЭлемента(
		Новый ОписаниеОповещения("СтрокаДляИндивидуальногоЛистаВыбрана", ЭтотОбъект, ПараметрыВыбора),
		"Строка изделия в заказе");
КонецПроцедуры

&НаКлиенте
Процедура СтрокаДляИндивидуальногоЛистаВыбрана(Результат, ПараметрыВыбора) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Попытка
		НовыйЛист = СоздатьРедакциюНаСервере(ПараметрыВыбора.ИсходныйТехЛист, Истина,
			ПараметрыВыбора.Заказ, Результат.Значение);
		ОткрытьКарточку(НовыйЛист);
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПечатьТехЛиста(Команда)
	Если Модифицированность ИЛИ НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПоказатьПредупреждение(, "Сохраните технический лист перед печатью.");
		Возврат;
	КонецЕсли;
	ПечатнаяФорма = ПечатнаяФормаНаСервере(Объект.Ссылка);
	ПечатнаяФорма.Показать("Технический лист");
КонецПроцедуры

&НаКлиенте
Асинх Процедура ПрикрепитьФайл(Команда)
	Попытка
		ОписаниеФайла = Ждать ПоместитьФайлНаСерверАсинх(,,,, УникальныйИдентификатор);
		Если ОписаниеФайла = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Файл = Новый Файл(ОписаниеФайла.СсылкаНаФайл.Имя);
		ДобавитьФайлНаСервере(ОписаниеФайла.Адрес, Файл.Имя);
		Модифицированность = Истина;
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Асинх Процедура СохранитьФайл(Команда)
	СтрокаФайла = Элементы.Файлы.ТекущиеДанные;
	Если СтрокаФайла = Неопределено Тогда
		ПоказатьПредупреждение(, "Выберите вложение в таблице файлов.");
		Возврат;
	КонецЕсли;
	Попытка
		Адрес = АдресФайлаНаСервере(СтрокаФайла.Идентификатор);
		Если ЗначениеЗаполнено(Адрес) Тогда
			Ждать ПолучитьФайлССервераАсинх(Адрес, СтрокаФайла.ИмяФайла);
		КонецЕсли;
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОткрытьКарточку(Ссылка)
	ОткрытьФорму("Справочник.Расш1_ТехническиеЛисты.Форма.ФормаЭлемента", Новый Структура("Ключ", Ссылка));
КонецПроцедуры

&НаСервере
Процедура ПересчитатьНаСервере()
	Лист = РеквизитФормыВЗначение("Объект");
	СообщениеРасчета = Расш1_ТехническиеЛистыСервер.Пересчитать(Лист);
	ЗначениеВРеквизитФормы(Лист, "Объект");
	НастроитьДоступность();
	ОбновитьЯчейкиЛиста();
КонецПроцедуры

&НаСервере
Процедура УтвердитьНаСервере()
	Лист = РеквизитФормыВЗначение("Объект");
	Лист.Состояние = Перечисления.Расш1_СостоянияТЛ.Утвержден;
	Лист.Записать();
	ЗначениеВРеквизитФормы(Лист, "Объект");
	СообщениеРасчета = "Редакция утверждена. Для изменения создайте следующую редакцию.";
	НастроитьДоступность();
КонецПроцедуры

&НаСервере
Процедура НастроитьДоступность()
	Элементы.Назначение.Видимость = Объект.Индивидуальный;
	Элементы.СообщениеРасчета.Видимость = НЕ ПустаяСтрока(СообщениеРасчета);
	Редактирование = Расш1_ТехническиеЛистыСервер.МожноРедактировать()
		И Объект.Состояние = Перечисления.Расш1_СостоянияТЛ.Черновик;
	ЗащищенныеПоля = СтрРазделить("Состояние,Редакция,ПредыдущаяРедакция,ИсходныйТехЛист,Автор,ДатаСоздания,Утвердил,ДатаУтверждения", ",");
	Для Каждого Элемент Из Элементы Цикл
		Если ТипЗнч(Элемент) = Тип("ПолеФормы") Тогда
			АвтоМатериал = Лев(Элемент.Имя, 9) = "Материалы" И Элемент.Имя <> "МатериалыКорректировка";
			Элемент.ТолькоПросмотр = НЕ Редактирование ИЛИ АвтоМатериал
				ИЛИ Элемент.Вид = ВидПоляФормы.ПолеКартинки
				ИЛИ Лев(Элемент.Имя, 14) = "ЛистКоличество"
				ИЛИ ЗащищенныеПоля.Найти(Элемент.Имя) <> Неопределено;
		ИначеЕсли ТипЗнч(Элемент) = Тип("ТаблицаФормы") Тогда
			Элемент.ТолькоПросмотр = НЕ Редактирование;
		КонецЕсли;
	КонецЦикла;
	Для Каждого ИмяКнопки Из СтрРазделить("Записать,ЗаписатьИЗакрыть,ПересчитатьМатериалы,Утвердить,ПрикрепитьФайл", ",") Цикл
		Элементы[ИмяКнопки].Видимость = Редактирование;
	КонецЦикла;
	Утвержден = Объект.Состояние = Перечисления.Расш1_СостоянияТЛ.Утвержден;
	Элементы.НоваяРедакция.Видимость = Утвержден И Расш1_ТехническиеЛистыСервер.МожноРедактировать();
	Элементы.ИндивидуальныйЛист.Видимость = Элементы.НоваяРедакция.Видимость;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ДанныеОперацииНаСервере(Знач Операция)
	Возврат Расш1_ТехническиеЛистыСервер.ДанныеОперации(Операция);
КонецФункции

&НаСервереБезКонтекста
Функция СоздатьРедакциюНаСервере(Знач Ссылка, Знач Индивидуальный = Ложь, Знач Заказ = Неопределено, Знач НомерСтроки = 0)
	Возврат Расш1_ТехническиеЛистыСервер.СоздатьРедакцию(Ссылка, Индивидуальный, Заказ, НомерСтроки);
КонецФункции

&НаСервереБезКонтекста
Функция СтрокиЗаказаНаСервере(Знач Заказ)
	Возврат Расш1_ТехническиеЛистыСервер.СтрокиЗаказаДляВыбора(Заказ);
КонецФункции

&НаСервереБезКонтекста
Функция ПечатнаяФормаНаСервере(Знач Ссылка)
	Возврат Расш1_ПечатьТЛСервер.Сформировать(Ссылка);
КонецФункции

&НаСервере
Процедура ДобавитьФайлНаСервере(Знач Адрес, Знач ИмяФайла)
	Расш1_ТехническиеЛистыСервер.ПроверитьПравоРедактирования();
	Если Объект.Состояние <> Перечисления.Расш1_СостоянияТЛ.Черновик Тогда
		ВызватьИсключение "Утверждённые вложения не изменяются.";
	КонецЕсли;
	Данные = ПолучитьИзВременногоХранилища(Адрес);
	Если ТипЗнч(Данные) <> Тип("ДвоичныеДанные") Тогда
		ВызватьИсключение "Не удалось получить содержимое файла.";
	КонецЕсли;
	Если Данные.Размер() > 20971520 Тогда
		ВызватьИсключение "Размер одного вложения не должен превышать 20 МБ.";
	КонецЕсли;
	Лист = РеквизитФормыВЗначение("Объект");
	Вложение = Лист.Файлы.Добавить();
	Вложение.Идентификатор = Строка(Новый УникальныйИдентификатор);
	Вложение.ИмяФайла = ИмяФайла;
	Вложение.Наименование = ИмяФайла;
	Вложение.Данные = Новый ХранилищеЗначения(Данные, Новый СжатиеДанных(6));
	ЗначениеВРеквизитФормы(Лист, "Объект");
	ОбновитьИзображенияЛиста();
КонецПроцедуры

&НаСервере
Функция АдресФайлаНаСервере(Знач ИД)
	Лист = РеквизитФормыВЗначение("Объект");
	Вложение = Лист.Файлы.Найти(ИД, "Идентификатор");
	Если Вложение = Неопределено ИЛИ Вложение.Данные = Неопределено Тогда
		ВызватьИсключение "У выбранной строки нет сохранённого файла.";
	КонецЕсли;
	Данные = Вложение.Данные.Получить();
	Если Данные = Неопределено Тогда
		ВызватьИсключение "Содержимое вложения отсутствует.";
	КонецЕсли;
	Возврат ПоместитьВоВременноеХранилище(Данные, УникальныйИдентификатор);
КонецФункции

&НаСервере
Процедура ИзменитьЯчейкуЛистаНаСервере(Знач Имя)
	Расш1_ТехническиеЛистыСервер.ПроверитьПравоРедактирования();
	Если Объект.Состояние <> Перечисления.Расш1_СостоянияТЛ.Черновик Тогда
		ВызватьИсключение "Утверждённый технический лист недоступен для изменения.";
	КонецЕсли;
	Для Каждого Ячейка Из Расш1_СхемаТЛСервер.ЯчейкиЛиста() Цикл
		Если Ячейка.Имя = Имя Тогда
			Лист = РеквизитФормыВЗначение("Объект");
			ИмяПривязки = "ЛистИД" + Ячейка.Таблица + Строка(Ячейка.Номер);
			ЭтотОбъект[ИмяПривязки] = Расш1_ЯчейкиЛистаТЛ.ИзменитьЯчейку(Лист[Ячейка.Таблица], Ячейка.Таблица,
				ЭтотОбъект[ИмяПривязки], Ячейка.Реквизит, ЭтотОбъект[Имя]);
			ЗначениеВРеквизитФормы(Лист, "Объект");
			ПересчитатьНаСервере();
			Возврат;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Ячейка Из Расш1_СхемаТЛСервер.ШкалыЛиста() Цикл
		Если Ячейка.Имя <> Имя Тогда
			Продолжить;
		КонецЕсли;
		Значение = Ячейка.Значение;
		Если Ячейка.Реквизит = "ЦветСтекла" Тогда
			Значение = ПредопределенноеЗначение("Справочник.Расш1_ЦветаСтекол." + Значение);
		КонецЕсли;
		Если ЭтотОбъект[Имя] Тогда
			Объект[Ячейка.Реквизит] = Значение;
		ИначеЕсли Объект[Ячейка.Реквизит] = Значение Тогда
			ТипРеквизита = Метаданные.Справочники.Расш1_ТехническиеЛисты.Реквизиты[Ячейка.Реквизит].Тип;
			Объект[Ячейка.Реквизит] = ТипРеквизита.ПривестиЗначение(Неопределено);
		КонецЕсли;
		ПересчитатьНаСервере();
		Возврат;
	КонецЦикла;
	ВызватьИсключение "Неизвестная ячейка технического листа.";
КонецПроцедуры

&НаСервере
Процедура ОбновитьЯчейкиЛиста()
	ЛистКоличествоОтверстий = 0;
	Для Каждого Отверстие Из Объект.Отверстия Цикл
		ЛистКоличествоОтверстий = ЛистКоличествоОтверстий + Отверстие.Количество;
	КонецЦикла;
	ЛистКоличествоСлоев = 0;
	Для Каждого Слой Из Объект.СлоиПечати Цикл
		Если Слой.Использовать Тогда
			ЛистКоличествоСлоев = ЛистКоличествоСлоев + 1;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Описание Из СтрРазделить("Отверстия:1,СлоиПечати:3,Коннекторы:4", ",") Цикл
		Части = СтрРазделить(Описание, ":");
		ИмяТаблицы = Части[0];
		Количество = Число(Части[1]);
		Старые = Новый Массив;
		Для Индекс = 1 По Количество Цикл
			Старые.Добавить(ЭтотОбъект["ЛистИД" + ИмяТаблицы + Строка(Индекс)]);
		КонецЦикла;
		Новые = Расш1_ЯчейкиЛистаТЛ.ПривязкиКолонок(Объект[ИмяТаблицы], Старые, Количество);
		Для Индекс = 1 По Количество Цикл
			ЭтотОбъект["ЛистИД" + ИмяТаблицы + Строка(Индекс)] = Новые[Индекс - 1];
		КонецЦикла;
	КонецЦикла;
	Для Каждого Ячейка Из Расш1_СхемаТЛСервер.ЯчейкиЛиста() Цикл
		Таблица = Объект[Ячейка.Таблица];
		СтрокаТаблицы = Неопределено;
		ИД = ЭтотОбъект["ЛистИД" + Ячейка.Таблица + Строка(Ячейка.Номер)];
		Для Каждого Элемент Из Таблица Цикл
			Если Элемент.Идентификатор = ИД И НЕ ПустаяСтрока(ИД) Тогда
				СтрокаТаблицы = Элемент;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если СтрокаТаблицы <> Неопределено Тогда
			ЭтотОбъект[Ячейка.Имя] = СтрокаТаблицы[Ячейка.Реквизит];
		Иначе
			ТипРеквизита = Метаданные.Справочники.Расш1_ТехническиеЛисты.ТабличныеЧасти[Ячейка.Таблица].Реквизиты[Ячейка.Реквизит].Тип;
			ЭтотОбъект[Ячейка.Имя] = ТипРеквизита.ПривестиЗначение(Неопределено);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Ячейка Из Расш1_СхемаТЛСервер.ШкалыЛиста() Цикл
		Значение = Ячейка.Значение;
		Если Ячейка.Реквизит = "ЦветСтекла" Тогда
			Значение = ПредопределенноеЗначение("Справочник.Расш1_ЦветаСтекол." + Значение);
		КонецЕсли;
		ЭтотОбъект[Ячейка.Имя] = (Объект[Ячейка.Реквизит] = Значение);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура НастроитьФорматЛиста()
	Для Каждого Элемент Из Элементы Цикл
		Если ТипЗнч(Элемент) <> Тип("ПолеФормы") Тогда
			Продолжить;
		КонецЕсли;
		Если Элемент.Вид <> ВидПоляФормы.ПолеВвода Тогда
			Продолжить;
		КонецЕсли;
		Если Элемент.Имя = "Наименование" ИЛИ ПустаяСтрока(Элемент.ПутьКДанным) Тогда
			Продолжить;
		КонецЕсли;
		Части = СтрРазделить(Элемент.ПутьКДанным, ".");
		Если Части.Количество() = 1 Тогда
			Значение = ЭтотОбъект[Части[0]];
		ИначеЕсли Части.Количество() = 2 Тогда
			Значение = Объект[Части[1]];
		Иначе
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(Значение) = Тип("Число") Тогда
			Элемент.Формат = "ЧГ=0;ЧН=";
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ОбновитьИзображенияНаСервере()
	ОбновитьИзображенияЛиста();
КонецПроцедуры

&НаСервере
Процедура ОбновитьИзображенияЛиста()
	Назначения = Новый Соответствие;
	Назначения.Вставить("Чертёж", "ЛистЧертеж");
	Назначения.Вставить("Маркировка", "ЛистМаркировка");
	Назначения.Вставить("Фото изделия 1", "ЛистФото1");
	Назначения.Вставить("Фото изделия 2", "ЛистФото2");
	Назначения.Вставить("Фото изделия 3", "ЛистФото3");
	Если Элементы.ФайлыНазначение.СписокВыбора.Количество() = 0 Тогда
		Для Каждого Назначение Из Назначения Цикл
			Элементы.ФайлыНазначение.СписокВыбора.Добавить(Назначение.Ключ);
		КонецЦикла;
		Элементы.ФайлыНазначение.РежимВыбораИзСписка = Истина;
	КонецЕсли;
	Для Каждого Назначение Из Назначения Цикл
		Адрес = ЭтотОбъект[Назначение.Значение];
		Если ЭтоАдресВременногоХранилища(Адрес) Тогда
			УдалитьИзВременногоХранилища(Адрес);
		КонецЕсли;
		ЭтотОбъект[Назначение.Значение] = "";
	КонецЦикла;
	Лист = РеквизитФормыВЗначение("Объект");
	Для Каждого ФайлЛиста Из Лист.Файлы Цикл
		Данные = ДанныеИзображенияЛиста(ФайлЛиста);
		Если Данные = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ПолеИзображения = Назначения.Получить(ФайлЛиста.Назначение);
		Если ПолеИзображения = Неопределено Тогда
			Для Каждого ИмяПоля Из СтрРазделить("ЛистЧертеж,ЛистФото1,ЛистФото2,ЛистФото3", ",") Цикл
				Если ПустаяСтрока(ЭтотОбъект[ИмяПоля]) Тогда
					ПолеИзображения = ИмяПоля;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если ПолеИзображения = Неопределено ИЛИ НЕ ПустаяСтрока(ЭтотОбъект[ПолеИзображения]) Тогда
			Продолжить;
		КонецЕсли;
		ЭтотОбъект[ПолеИзображения] = ПоместитьВоВременноеХранилище(Данные, УникальныйИдентификатор);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция ДанныеИзображенияЛиста(ФайлЛиста)
	Если ПустаяСтрока(ФайлЛиста.ИмяФайла) ИЛИ ФайлЛиста.Данные = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Расширение = НРег((Новый Файл(ФайлЛиста.ИмяФайла)).Расширение);
		Если СтрРазделить(".png,.jpg,.jpeg,.gif,.bmp", ",").Найти(Расширение) = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Данные = ФайлЛиста.Данные.Получить();
		Если ТипЗнч(Данные) <> Тип("ДвоичныеДанные") ИЛИ Данные.Размер() > 20971520 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Картинка = Новый Картинка(Данные);
		Возврат Картинка.ПолучитьДвоичныеДанные();
	Исключение
		// Исходное вложение сохраняется и доступно для скачивания.
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

#КонецОбласти
