#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	НастроитьОформлениеОстатка();
	Если НЕ Объект.Ссылка.Пустая() Тогда
		// Исторический документ открывается для просмотра, не как новая порция.
		Расш1_РежимПросмотра = Истина;
		Элементы.ЗаписатьПорцию.Видимость = Ложь;
		Элементы.ЗаписатьИЗакрытьПорцию.Видимость = Ложь;
		Элементы.ПродукцияВыполнено.ТолькоПросмотр = Истина;
		Элементы.ПродукцияБрак.ТолькоПросмотр = Истина;
		Расш1_ВыработкаСервер.ПроверитьДоступКЗаказу(Объект.Заказ, Объект.Участок);
		ОбновитьЗаголовок();
		Возврат;
	КонецЕсли;
	Если НЕ Параметры.Свойство("Заказ") ИЛИ НЕ Параметры.Свойство("Участок") Тогда
		ВызватьИсключение "Откройте выработку из журнала заказов в работу.";
	КонецЕсли;
	ЗначениеВРеквизитФормы(НоваяПорция(Параметры.Заказ, Параметры.Участок), "Объект");
	ОбновитьЗаголовок();
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	// Включая крестик вкладки: незаписанный ввод не сохраняется.
	Модифицированность = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	// Ctrl+S и стандартная запись не должны сохранять непроведённую порцию.
	Отказ = Истина;
	СообщениеФормы = "Используйте команды «Записать» или «Записать и закрыть» рабочего места.";
КонецПроцедуры

#КонецОбласти

#Область КомандыИЭлементыФормы

&НаКлиенте
Процедура КоличествоПриИзменении(Элемент)
	СообщениеФормы = "";
	Для Каждого СтрокаПродукции Из Объект.Продукция Цикл
		СтрокаПродукции.Осталось = СтрокаПродукции.План - СтрокаПродукции.ВыполненоРанее
			- СтрокаПродукции.Выполнено - СтрокаПродукции.Брак;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьПорцию(Команда)
	СохранитьПорцию(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьИЗакрытьПорцию(Команда)
	СохранитьПорцию(Истина);
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьБезЗаписи(Команда)
	Модифицированность = Ложь;
	Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура СохранитьПорцию(ЗакрытьПослеЗаписи)
	Если Расш1_РежимПросмотра Тогда
		Возврат;
	КонецЕсли;
	КоличествоПриИзменении(Неопределено);
	Для Каждого СтрокаПродукции Из Объект.Продукция Цикл
		Если СтрокаПродукции.Осталось < 0 Тогда
			СообщениеФормы = "Выполнено и брак вместе не могут превышать остаток по заказу.";
			Возврат;
		КонецЕсли;
	КонецЦикла;
	Если НЕ ЗаписатьПорциюНаСервере() Тогда
		Возврат;
	КонецЕсли;
	Модифицированность = Ложь;
	Оповестить("Расш1_ВыработкаЗаписана", Объект.Заказ, ЭтотОбъект);
	Если ЗакрытьПослеЗаписи Тогда
		Закрыть();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьЗаголовок()
	НомерЗаказа = Объект.Заказ.Номер;
	Заголовок = "Выработка по заказу " + НомерЗаказа;
КонецПроцедуры

&НаСервере
Функция НоваяПорция(Заказ, Участок)
	Контекст = Расш1_ВыработкаСервер.ПроверитьДоступКЗаказу(Заказ, Участок);
	Документ = Документы.Выработка.СоздатьДокумент();
	Документ.Заказ = Заказ;
	Документ.Участок = Участок;
	Документ.Работник = Контекст.Работник;
	Документ.Дата = ТекущаяДатаСеанса();
	СтрокиПродукции = Расш1_ВыработкаСервер.СтрокиЗаказов(Заказ);
	Для Каждого СтрокаЗаказа Из СтрокиПродукции Цикл
		СтрокаПродукции = Документ.Продукция.Добавить();
		СтрокаПродукции.Расш1_НомерСтрокиЗаказа = СтрокаЗаказа.НомерСтрокиЗаказа;
		СтрокаПродукции.Номенклатура = СтрокаЗаказа.Номенклатура;
		СтрокаПродукции.Характеристика = СтрокаЗаказа.Характеристика;
		СтрокаПродукции.Расш1_Изделие = Строка(СтрокаЗаказа.Номенклатура);
		Если ЗначениеЗаполнено(СтрокаЗаказа.Характеристика) Тогда
			СтрокаПродукции.Расш1_Изделие = СтрокаПродукции.Расш1_Изделие
				+ " / " + Строка(СтрокаЗаказа.Характеристика);
		КонецЕсли;
		СтрокаПродукции.План = СтрокаЗаказа.План;
		СтрокаПродукции.ВыполненоРанее = СтрокаЗаказа.Выполнено;
		СтрокаПродукции.Выполнено = 0;
		СтрокаПродукции.Брак = 0;
		СтрокаПродукции.Осталось = СтрокаЗаказа.План - СтрокаЗаказа.Выполнено;
	КонецЦикла;
	Возврат Документ;
КонецФункции

&НаСервере
Функция ЗаписатьПорциюНаСервере()
	Если Расш1_РежимПросмотра ИЛИ НЕ Объект.Ссылка.Пустая() Тогда
		ВызватьИсключение "Историческая выработка открыта только для просмотра.";
	КонецЕсли;
	ЕстьДанные = Ложь;
	Для Каждого СтрокаПродукции Из Объект.Продукция Цикл
		ЕстьДанные = ЕстьДанные ИЛИ СтрокаПродукции.Выполнено <> 0 ИЛИ СтрокаПродукции.Брак <> 0;
	КонецЦикла;
	Если НЕ ЕстьДанные Тогда
		СообщениеФормы = "Нет данных для записи.";
		Возврат Ложь;
	КонецЕсли;
	НачатьТранзакцию();
	Попытка
		Документ = РеквизитФормыВЗначение("Объект");
		Документ.Записать(РежимЗаписиДокумента.Проведение);
		// Готовим следующий ввод до фиксации: сбой перечитывания не должен
		// оставлять записанную порцию на экране для повторной отправки.
		СледующаяПорция = НоваяПорция(Документ.Заказ, Документ.Участок);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		СообщениеФормы = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Ложь;
	КонецПопытки;
	ЗначениеВРеквизитФормы(СледующаяПорция, "Объект");
	СообщениеФормы = "Данные записаны.";
	Возврат Истина;
КонецФункции

&НаСервере
Процедура НастроитьОформлениеОстатка()
	Оформление = УсловноеОформление.Элементы.Добавить();
	ПолеОформления = Оформление.Поля.Элементы.Добавить();
	ПолеОформления.Поле = Новый ПолеКомпоновкиДанных("ПродукцияОсталось");
	Отбор = Оформление.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Продукция.Осталось");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Меньше;
	Отбор.ПравоеЗначение = 0;
	Отбор.Использование = Истина;
	Оформление.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Красный);
	Оформление.Использование = Истина;
КонецПроцедуры

#КонецОбласти
