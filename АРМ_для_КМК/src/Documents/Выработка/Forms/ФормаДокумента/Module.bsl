#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Объект.Ссылка.Пустая() И ЗначениеЗаполнено(Объект.Заказ) Тогда
		ЗаполнитьПоЗаказу();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьПоЗаказу()
	Объект.Продукция.Очистить();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Прод.Номенклатура КАК Номенклатура,
	|	Прод.Характеристика КАК Характеристика,
	|	Прод.Количество КАК План,
	|	ЕСТЬNULL(Ост.Выполнено, 0) КАК Выполнено
	|ИЗ
	|	Документ.ЗаказНаПроизводство.Продукция КАК Прод
	|		ЛЕВОЕ СОЕДИНЕНИЕ (
	|			ВЫБРАТЬ
	|				Рег.Номенклатура КАК Номенклатура,
	|				Рег.Характеристика КАК Характеристика,
	|				СУММА(Рег.Выполнено) КАК Выполнено
	|			ИЗ
	|				РегистрНакопления.ВыработкаПоЗаказам КАК Рег
	|			ГДЕ
	|				Рег.Период <= &ДатаОстатков
	|				И Рег.Заказ = &Заказ
	|			СГРУППИРОВАТЬ ПО
	|				Рег.Номенклатура,
	|				Рег.Характеристика
	|		) КАК Ост
	|			ПО Ост.Номенклатура = Прод.Номенклатура
	|				И Ост.Характеристика = Прод.Характеристика
	|ГДЕ
	|	Прод.Ссылка = &Заказ";

	Запрос.УстановитьПараметр("Заказ", Объект.Заказ);
	Запрос.УстановитьПараметр("ДатаОстатков", КонецДня(ТекущаяДатаСеанса()));

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = Объект.Продукция.Добавить();
		Строка.Номенклатура = Выборка.Номенклатура;
		Строка.Характеристика = Выборка.Характеристика;
		Строка.План = Выборка.План;
		Строка.ВыполненоРанее = Выборка.Выполнено;
		Строка.Осталось = Макс(Выборка.План - Выборка.Выполнено, 0);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти
