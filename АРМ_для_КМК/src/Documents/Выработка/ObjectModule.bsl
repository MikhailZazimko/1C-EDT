#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Расш1_ВыработкаСервер.ПроверитьДокумент(ЭтотОбъект);

	РассчитатьПростои(Отказ);
	РассчитатьСуммуКВыплате();
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	ПроверитьПересечениеПростоев(Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Движения.ВыработкаПоЗаказам.Записывать = Истина;
	Для Каждого Строка Из Продукция Цикл
		Если Строка.Выполнено = 0 И Строка.Брак = 0 Тогда
			Продолжить;
		КонецЕсли;
		Движение = Движения.ВыработкаПоЗаказам.Добавить();
		Движение.Период = Дата;
		Движение.Заказ = Заказ;
		Движение.Номенклатура = Строка.Номенклатура;
		Движение.Характеристика = Строка.Характеристика;
		Движение.Участок = Участок;
		Движение.Расш1_НомерСтрокиЗаказа = Строка.Расш1_НомерСтрокиЗаказа;
		Движение.Выполнено = Строка.Выполнено;
		Движение.Брак = Строка.Брак;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура РассчитатьПростои(Отказ)
	Для Каждого Строка Из Простои Цикл
		Если ЗначениеЗаполнено(Строка.НачалоПростоя) И ЗначениеЗаполнено(Строка.ОкончаниеПростоя) Тогда
			Строка.Часы = (Строка.ОкончаниеПростоя - Строка.НачалоПростоя) / 3600;
		КонецЕсли;

		Если Строка.Часы < 0 Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Окончание простоя не может быть раньше его начала.";
			Сообщение.Сообщить();
			Отказ = Истина;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура РассчитатьСуммуКВыплате()
	Если НЕ ЗначениеЗаполнено(Участок) Тогда
		СуммаКВыплате = 0;
		Возврат;
	КонецЕсли;

	ЗапросРасценок = Новый Запрос;
	ЗапросРасценок.Текст =
	"ВЫБРАТЬ
	|	Расценки.Номенклатура КАК Номенклатура,
	|	Расценки.Сумма КАК Сумма
	|ИЗ
	|	Справочник.Расценки КАК Расценки
	|ГДЕ
	|	Расценки.Участок = &Участок
	|	И Расценки.ВидРасценки = ЗНАЧЕНИЕ(Перечисление.ВидыРасценок.ЗаЕдиницу)";
	ЗапросРасценок.УстановитьПараметр("Участок", Участок);

	РасценкиПоНоменклатуре = Новый Соответствие;
	ВыборкаРасценок = ЗапросРасценок.Выполнить().Выбрать();
	Пока ВыборкаРасценок.Следующий() Цикл
		РасценкиПоНоменклатуре.Вставить(ВыборкаРасценок.Номенклатура, ВыборкаРасценок.Сумма);
	КонецЦикла;

	ЗапросЧаса = Новый Запрос;
	ЗапросЧаса.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Расценки.Сумма КАК Сумма
	|ИЗ
	|	Справочник.Расценки КАК Расценки
	|ГДЕ
	|	Расценки.Участок = &Участок
	|	И Расценки.ВидРасценки = ЗНАЧЕНИЕ(Перечисление.ВидыРасценок.ЗаЧасПростоя)";
	ЗапросЧаса.УстановитьПараметр("Участок", Участок);

	СтоимостьЧаса = 0;
	ВыборкаЧаса = ЗапросЧаса.Выполнить().Выбрать();
	Если ВыборкаЧаса.Следующий() Тогда
		СтоимостьЧаса = ВыборкаЧаса.Сумма;
	КонецЕсли;

	Сумма = 0;

	Для Каждого Строка Из Продукция Цикл
		Если Строка.Выполнено <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Расценка = РасценкиПоНоменклатуре[Строка.Номенклатура];
		Если Расценка <> Неопределено Тогда
			Сумма = Сумма + Строка.Выполнено * Расценка;
		КонецЕсли;
	КонецЦикла;

	Для Каждого Строка Из Простои Цикл
		Сумма = Сумма + Строка.Часы * СтоимостьЧаса;
	КонецЦикла;

	СуммаКВыплате = Сумма;
КонецПроцедуры

Процедура ПроверитьПересечениеПростоев(Отказ)
	Если НЕ ЗначениеЗаполнено(Участок) Тогда
		Возврат;
	КонецЕсли;

	ЕстьОрганизационный = Ложь;
	МинНачало = Неопределено;
	МаксОкончание = Неопределено;

	Для Каждого Строка Из Простои Цикл
		Если Строка.ВидПростоя <> Перечисления.ВидыПростоев.Организационный Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Строка.НачалоПростоя) ИЛИ НЕ ЗначениеЗаполнено(Строка.ОкончаниеПростоя) Тогда
			Продолжить;
		КонецЕсли;

		ЕстьОрганизационный = Истина;
		Если МинНачало = Неопределено ИЛИ Строка.НачалоПростоя < МинНачало Тогда
			МинНачало = Строка.НачалоПростоя;
		КонецЕсли;
		Если МаксОкончание = Неопределено ИЛИ Строка.ОкончаниеПростоя > МаксОкончание Тогда
			МаксОкончание = Строка.ОкончаниеПростоя;
		КонецЕсли;
	КонецЦикла;

	Если НЕ ЕстьОрганизационный Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Прод.НачалоПростоя КАК Начало,
	|	Прод.ОкончаниеПростоя КАК Окончание
	|ИЗ
	|	Документ.Выработка.Простои КАК Прод
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Выработка КАК Док
	|			ПО Прод.Ссылка = Док.Ссылка
	|ГДЕ
	|	Док.Участок = &Участок
	|	И Док.Ссылка <> &Ссылка
	|	И НЕ Док.ПометкаУдаления
	|	И Док.Проведен
	|	И Прод.ВидПростоя = ЗНАЧЕНИЕ(Перечисление.ВидыПростоев.Организационный)
	|	И Прод.НачалоПростоя <= &МаксОкончание
	|	И Прод.ОкончаниеПростоя >= &МинНачало";
	Запрос.УстановитьПараметр("Участок", Участок);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("МинНачало", МинНачало);
	Запрос.УстановитьПараметр("МаксОкончание", МаксОкончание);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Для Каждого Строка Из Простои Цикл
			Если Строка.ВидПростоя <> Перечисления.ВидыПростоев.Организационный Тогда
				Продолжить;
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(Строка.НачалоПростоя) ИЛИ НЕ ЗначениеЗаполнено(Строка.ОкончаниеПростоя) Тогда
				Продолжить;
			КонецЕсли;
			Если Строка.НачалоПростоя < Выборка.Окончание И Строка.ОкончаниеПростоя > Выборка.Начало Тогда
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Организационный простой на участке пересекается с уже проведённым простоем за период с "
					+ Формат(Выборка.Начало, "ДЛФ=DT") + " по " + Формат(Выборка.Окончание, "ДЛФ=DT") + ".";
				Сообщение.Сообщить();
				Отказ = Истина;
				Возврат;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти
