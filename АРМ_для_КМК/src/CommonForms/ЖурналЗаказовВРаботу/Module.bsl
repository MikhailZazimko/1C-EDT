#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ОтборСтатус = "Все";
	Элементы.ОтборСтатус.СписокВыбора.Добавить("Все");
	Элементы.ОтборСтатус.СписокВыбора.Добавить("К выполнению");
	Элементы.ОтборСтатус.СписокВыбора.Добавить("В работе");
	Элементы.ОтборСтатус.СписокВыбора.Добавить("Выполнен");
	ЗаполнитьСписок();
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "Расш1_ВыработкаЗаписана" Тогда
		ЗаполнитьСписок();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область КомандыИЭлементыФормы

&НаКлиенте
Процедура ОтборИзменен(Элемент)
	ЗаполнитьСписок();
КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
	ЗаполнитьСписок();
КонецПроцедуры

&НаКлиенте
Процедура ВзятьВРаботу(Команда)
	ОткрытьТекущийЗаказ();
КонецПроцедуры

&НаКлиенте
Процедура СписокЗаказовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ОткрытьТекущийЗаказ();
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьТекущийЗаказ()
	ТекущиеДанные = Элементы.СписокЗаказов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Сообщить("Выберите заказ в списке.");
		Возврат;
	КонецЕсли;
	ПараметрыФормы = Новый Структура("Заказ,Участок", ТекущиеДанные.Заказ, ТекущиеДанные.Участок);
	ОткрытьФорму("Документ.Выработка.Форма.ФормаДокумента", ПараметрыФормы, ЭтотОбъект);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьСписок()
	Если НЕ ЗначениеЗаполнено(ОтборСтатус) Тогда
		ОтборСтатус = "Все";
	КонецЕсли;
	Контекст = Расш1_ВыработкаСервер.КонтекстРаботника();
	РольИРаботник = Контекст.Роль + ": " + Строка(Контекст.Работник);
	СписокЗаказов.Очистить();
	СтрокиПродукции = Расш1_ВыработкаСервер.СтрокиЗаказов();
	ТекущийЗаказ = Неопределено;
	СтрокаСписка = Неопределено;
	КоличествоИзделий = 0;
	Для Каждого СтрокаПродукции Из СтрокиПродукции Цикл
		Если ТекущийЗаказ <> СтрокаПродукции.Заказ Тогда
			Если СтрокаСписка <> Неопределено Тогда
				ЗавершитьСтроку(СтрокаСписка, КоличествоИзделий);
			КонецЕсли;
			ТекущийЗаказ = СтрокаПродукции.Заказ;
			СтрокаСписка = СписокЗаказов.Добавить();
			СтрокаСписка.Заказ = СтрокаПродукции.Заказ;
			СтрокаСписка.Участок = СтрокаПродукции.Участок;
			СтрокаСписка.НомерЗаказа = СтрокаПродукции.НомерЗаказа;
			СтрокаСписка.Изделие = Строка(СтрокаПродукции.Номенклатура);
			Если ЗначениеЗаполнено(СтрокаПродукции.Характеристика) Тогда
				СтрокаСписка.Изделие = СтрокаСписка.Изделие + " / " + Строка(СтрокаПродукции.Характеристика);
			КонецЕсли;
			КоличествоИзделий = 0;
		КонецЕсли;
		КоличествоИзделий = КоличествоИзделий + 1;
		СтрокаСписка.План = СтрокаСписка.План + СтрокаПродукции.План;
		СтрокаСписка.Выполнено = СтрокаСписка.Выполнено + СтрокаПродукции.Выполнено;
	КонецЦикла;
	Если СтрокаСписка <> Неопределено Тогда
		ЗавершитьСтроку(СтрокаСписка, КоличествоИзделий);
	КонецЕсли;

	// Оба отбора применяются к одной сводной строке, до подсчёта записей.
	КУдалению = Новый Массив;
	Для Каждого ЗаписьСписка Из СписокЗаказов Цикл
		Если (ОтборСтатус <> "Все" И ЗаписьСписка.Статус <> ОтборСтатус)
			ИЛИ (ЗначениеЗаполнено(ПоискНомера)
				И СтрНайти(ВРег(ЗаписьСписка.НомерЗаказа), ВРег(СокрЛП(ПоискНомера))) = 0) Тогда
			КУдалению.Добавить(ЗаписьСписка);
		КонецЕсли;
	КонецЦикла;
	Для Каждого ЗаписьСписка Из КУдалению Цикл
		СписокЗаказов.Удалить(ЗаписьСписка);
	КонецЦикла;
	ИтогиЖурнала = "Записей: " + Формат(СписокЗаказов.Количество(), "ЧГ=0")
		+ ". Двойной щелчок открывает форму.";
КонецПроцедуры

&НаСервере
Процедура ЗавершитьСтроку(СтрокаСписка, КоличествоИзделий)
	Если КоличествоИзделий > 1 Тогда
		СтрокаСписка.Изделие = СтрокаСписка.Изделие + " +" + Формат(КоличествоИзделий - 1, "ЧГ=0");
	КонецЕсли;
	СтрокаСписка.Осталось = СтрокаСписка.План - СтрокаСписка.Выполнено;
	СтрокаСписка.Статус = Расш1_ВыработкаСервер.СтатусПоКоличеству(
		СтрокаСписка.План, СтрокаСписка.Выполнено);
КонецПроцедуры

#КонецОбласти
