#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗаполнитьСписок();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборИзменен(Элемент)
	ЗаполнитьСписок();
КонецПроцедуры

&НаКлиенте
Процедура ОтборСтатусИзменен(Элемент)
	ЗаполнитьСписок();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписокЗаказов

&НаКлиенте
Процедура СписокЗаказовПриАктивизацииСтроки(Элемент)
	ТекущиеДанные = Элементы.СписокЗаказов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ОткрытьВыработку(ТекущиеДанные.Заказ, ТекущиеДанные.Участок);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаСервере
Процедура Обновить()
	ЗаполнитьСписок();
КонецПроцедуры

&НаСервере
Процедура ВзятьВРаботу()
	ТекущаяСтрока = Элементы.СписокЗаказов.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Выберите заказ в списке.";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;

	Состояние = ПолучитьСостояние("В работе");
	ОбъектЗаказа = ТекущаяСтрока.Заказ.ПолучитьОбъект();
	Если ОбъектЗаказа <> Неопределено И ОбъектЗаказа.СостояниеЗаказа <> Состояние Тогда
		ОбъектЗаказа.СостояниеЗаказа = Состояние;
		ОбъектЗаказа.Записать();
	КонецЕсли;

	ЗаполнитьСписок();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьСписок()
	СписокЗаказов.Очистить();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Прод.Ссылка КАК Заказ,
	|	Зак.Участок КАК Участок,
	|	Зак.СостояниеЗаказа КАК Статус,
	|	Прод.Номенклатура КАК Номенклатура,
	|	Прод.Характеристика КАК Характеристика,
	|	Прод.Количество КАК План,
	|	ЕСТЬNULL(Ост.Выполнено, 0) КАК Выполнено
	|ИЗ
	|	Документ.ЗаказНаПроизводство.Продукция КАК Прод
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказНаПроизводство КАК Зак
	|			ПО Прод.Ссылка = Зак.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ (
	|			ВЫБРАТЬ
	|				Рег.Заказ КАК Заказ,
	|				Рег.Номенклатура КАК Номенклатура,
	|				Рег.Характеристика КАК Характеристика,
	|				СУММА(Рег.Выполнено) КАК Выполнено
	|			ИЗ
	|				РегистрНакопления.ВыработкаПоЗаказам КАК Рег
	|			ГДЕ
	|				Рег.Период <= &ДатаОстатков
	|			СГРУППИРОВАТЬ ПО
	|				Рег.Заказ,
	|				Рег.Номенклатура,
	|				Рег.Характеристика
	|		) КАК Ост
	|			ПО Ост.Заказ = Прод.Ссылка
	|				И Ост.Номенклатура = Прод.Номенклатура
	|				И Ост.Характеристика = Прод.Характеристика
	|ГДЕ
	|	НЕ Зак.ПометкаУдаления
	|	И (&Участок = ЗНАЧЕНИЕ(Справочник.Участки.ПустаяСсылка) ИЛИ Зак.Участок = &Участок)
	|	И (&Статус = ЗНАЧЕНИЕ(Справочник.СостоянияЗаказовНаПроизводство.ПустаяСсылка) ИЛИ Зак.СостояниеЗаказа = &Статус)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Заказ.Дата УБЫВ";

	Запрос.УстановитьПараметр("ДатаОстатков", КонецДня(ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("Участок", ОтборУчасток);
	Запрос.УстановитьПараметр("Статус", ОтборСтатус);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = СписокЗаказов.Добавить();
		Строка.Заказ = Выборка.Заказ;
		Строка.Участок = Выборка.Участок;
		Строка.Номенклатура = Выборка.Номенклатура;
		Строка.Характеристика = Выборка.Характеристика;
		Строка.Изделие = ПредставлениеИзделия(Выборка.Номенклатура, Выборка.Характеристика);
		Строка.План = Выборка.План;
		Строка.Выполнено = Выборка.Выполнено;
		Строка.Осталось = Макс(Выборка.План - Выборка.Выполнено, 0);
		Строка.Статус = Строка(Выборка.Статус);
	КонецЦикла;

	Если СписокЗаказов.Количество() = 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Нет заказов по заданному отбору.";
		Сообщение.Сообщить();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПредставлениеИзделия(Номенклатура, Характеристика)
	Если ЗначениеЗаполнено(Характеристика) Тогда
		Возврат Строка(Номенклатура) + " / " + Строка(Характеристика);
	КонецЕсли;
	Возврат Строка(Номенклатура);
КонецФункции

&НаСервере
Функция ПолучитьСостояние(Наименование)
	Ссылка = Справочники.СостоянияЗаказовНаПроизводство.НайтиПоНаименованию(Наименование, Истина);
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Элемент = Справочники.СостоянияЗаказовНаПроизводство.СоздатьЭлемент();
		Элемент.Наименование = Наименование;
		Элемент.Записать();
		Ссылка = Элемент.Ссылка;
	КонецЕсли;
	Возврат Ссылка;
КонецФункции

&НаСервере
Процедура ОткрытьВыработку(Заказ, Участок)
	Если НЕ ЗначениеЗаполнено(Заказ) Тогда
		Возврат;
	КонецЕсли;
	Документ = Документы.Выработка.СоздатьДокумент();
	Документ.Дата = ТекущаяДатаСеанса();
	Документ.Заказ = Заказ;
	Документ.Участок = Участок;
	Форма = Документ.ПолучитьФорму("ФормаДокумента");
	Форма.Открыть();
КонецПроцедуры

#КонецОбласти
