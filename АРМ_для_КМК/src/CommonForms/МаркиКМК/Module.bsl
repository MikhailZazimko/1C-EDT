#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗаполнитьСписок();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаСервере
Процедура Обновить()
	ЗаполнитьСписок();
КонецПроцедуры

&НаКлиенте
Процедура Объединить(Команда)
	Выделенные = Элементы.Марки.ВыделенныеСтроки;
	Если Выделенные.Количество() < 2 Тогда
		ПоказатьПредупреждение(, "Выделите не менее двух марок для объединения.");
		Возврат;
	КонецЕсли;

	Ссылки = Новый Массив;
	Для Каждого Строка Из Выделенные Цикл
		Если ЗначениеЗаполнено(Строка.Марка) Тогда
			Ссылки.Добавить(Строка.Марка);
		КонецЕсли;
	КонецЦикла;

	Если Ссылки.Количество() < 2 Тогда
		ПоказатьПредупреждение(, "Выделите не менее двух марок для объединения.");
		Возврат;
	КонецЕсли;

	ОбъединитьМарки(Ссылки);
	ЗаполнитьСписок();
КонецПроцедуры

&НаКлиенте
Процедура Разделить(Команда)
	СтрокаМарки = Элементы.Марки.ТекущиеДанные;
	Если СтрокаМарки = Неопределено ИЛИ НЕ ЗначениеЗаполнено(СтрокаМарки.Марка) Тогда
		ПоказатьПредупреждение(, "Выберите марку для разделения.");
		Возврат;
	КонецЕсли;

	ПоказатьВводЧисла(Новый ОписаниеОповещения("РазделитьЗавершение", ЭтотОбъект, СтрокаМарки.Марка),
		1, "Количество для новой марки", 15, 3);
КонецПроцедуры

&НаКлиенте
Процедура РазделитьЗавершение(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если НЕ РазделитьМарку(ДополнительныеПараметры, Результат) Тогда
		Возврат;
	КонецЕсли;

	ЗаполнитьСписок();
КонецПроцедуры

&НаКлиенте
Процедура ПеревестиНаЗаказ(Команда)
	СтрокаМарки = Элементы.Марки.ТекущиеДанные;
	Если СтрокаМарки = Неопределено ИЛИ НЕ ЗначениеЗаполнено(СтрокаМарки.Марка) Тогда
		ПоказатьПредупреждение(, "Выберите марку для перевода на заказ.");
		Возврат;
	КонецЕсли;

	ПоказатьВводЗначения(Новый ОписаниеОповещения("ПеревестиНаЗаказЗавершение", ЭтотОбъект, СтрокаМарки.Марка),
		Неопределено, "Заказ", Тип("ДокументСсылка.ЗаказНаПроизводство"));
КонецПроцедуры

&НаКлиенте
Процедура ПеревестиНаЗаказЗавершение(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПеревестиМаркуНаЗаказ(ДополнительныеПараметры, Результат);
	ЗаполнитьСписок();
КонецПроцедуры

&НаКлиенте
Процедура ВывестиИзНП(Команда)
	Выделенные = Элементы.Марки.ВыделенныеСтроки;
	Если Выделенные.Количество() = 0 Тогда
		СтрокаМарки = Элементы.Марки.ТекущиеДанные;
		Если СтрокаМарки = Неопределено Тогда
			ПоказатьПредупреждение(, "Выберите марки со статусом НП.");
			Возврат;
		КонецЕсли;
		Выделенные = Новый Массив;
		Выделенные.Добавить(СтрокаМарки);
	КонецЕсли;

	Ссылки = Новый Массив;
	Для Каждого Строка Из Выделенные Цикл
		Если ЗначениеЗаполнено(Строка.Марка) Тогда
			Ссылки.Добавить(Строка.Марка);
		КонецЕсли;
	КонецЦикла;

	ВывестиМаркиИзНП(Ссылки);
	ЗаполнитьСписок();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьСписок()
	МаркиСписок.Очистить();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Марки.Ссылка КАК Марка,
	|	Марки.Заказ КАК Заказ,
	|	Марки.Номенклатура КАК Номенклатура,
	|	Марки.Характеристика КАК Характеристика,
	|	Марки.Участок КАК Участок,
	|	Марки.Статус КАК Статус,
	|	Марки.Количество КАК Количество
	|ИЗ
	|	Справочник.Марки КАК Марки
	|ГДЕ
	|	НЕ Марки.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Марки.Номенклатура,
	|	Марки.Ссылка";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = МаркиСписок.Добавить();
		Строка.Марка = Выборка.Марка;
		Строка.Заказ = Выборка.Заказ;
		Строка.Номенклатура = Выборка.Номенклатура;
		Строка.Характеристика = Выборка.Характеристика;
		Строка.Участок = Выборка.Участок;
		Строка.Статус = Строка(Выборка.Статус);
		Строка.Количество = Выборка.Количество;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ОбъединитьМарки(Ссылки)
	Если Ссылки.Количество() < 2 Тогда
		Возврат;
	КонецЕсли;

	ОбъектЦели = Ссылки[0].ПолучитьОбъект();
	Если ОбъектЦели = Неопределено Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не удалось прочитать выбранную марку.";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;

	ИтоговоеКоличество = ОбъектЦели.Количество;
	Для Индекс = 1 По Ссылки.ВГраница() Цикл
		ОбъектМарки = Ссылки[Индекс].ПолучитьОбъект();
		Если ОбъектМарки = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ИтоговоеКоличество = ИтоговоеКоличество + ОбъектМарки.Количество;
		ОбъектМарки.ПометкаУдаления = Истина;
		ОбъектМарки.Записать();
	КонецЦикла;

	ОбъектЦели.Количество = ИтоговоеКоличество;
	ОбъектЦели.Записать();
КонецПроцедуры

&НаСервере
Функция РазделитьМарку(Ссылка, НовоеКоличество)
	ОбъектМарки = Ссылка.ПолучитьОбъект();
	Если ОбъектМарки = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Если НовоеКоличество <= 0 ИЛИ НовоеКоличество >= ОбъектМарки.Количество Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Количество для новой марки должно быть больше нуля и меньше текущего количества.";
		Сообщение.Сообщить();
		Возврат Ложь;
	КонецЕсли;

	НоваяМарка = Справочники.Марки.СоздатьЭлемент();
	НоваяМарка.Заказ = ОбъектМарки.Заказ;
	НоваяМарка.Номенклатура = ОбъектМарки.Номенклатура;
	НоваяМарка.Характеристика = ОбъектМарки.Характеристика;
	НоваяМарка.Участок = ОбъектМарки.Участок;
	НоваяМарка.Статус = ОбъектМарки.Статус;
	НоваяМарка.ПредыдущаяМарка = ОбъектМарки.Ссылка;
	НоваяМарка.Количество = НовоеКоличество;
	НоваяМарка.Записать();

	ОбъектМарки.Количество = ОбъектМарки.Количество - НовоеКоличество;
	ОбъектМарки.Записать();

	Возврат Истина;
КонецФункции

&НаСервере
Процедура ПеревестиМаркуНаЗаказ(Ссылка, Заказ)
	ОбъектМарки = Ссылка.ПолучитьОбъект();
	Если ОбъектМарки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ОбъектМарки.Заказ = Заказ;
	ОбъектМарки.Записать();
КонецПроцедуры

&НаСервере
Процедура ВывестиМаркиИзНП(Ссылки)
	Если Ссылки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	КоличествоИзменено = 0;
	Для Каждого Ссылка Из Ссылки Цикл
		ОбъектМарки = Ссылка.ПолучитьОбъект();
		Если ОбъектМарки = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ОбъектМарки.Статус <> Перечисления.СтатусыМарок.НП Тогда
			Продолжить;
		КонецЕсли;
		ОбъектМарки.Статус = Перечисления.СтатусыМарок.Списана;
		ОбъектМарки.Записать();
		КоличествоИзменено = КоличествоИзменено + 1;
	КонецЦикла;

	Если КоличествоИзменено = 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Среди выбранных марок нет марок со статусом НП.";
		Сообщение.Сообщить();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
