#Область ПрограммныйИнтерфейс

Функция МожноРедактировать() Экспорт
	Возврат ПравоДоступа("Администрирование", Метаданные)
		ИЛИ РольДоступна("Расш1_Технолог") ИЛИ РольДоступна("Мастер");
КонецФункции

Процедура ПроверитьПравоРедактирования() Экспорт
	Если НЕ МожноРедактировать() Тогда
		ВызватьИсключение "Изменять технические листы и нормы может технолог, мастер или администратор ИБ.";
	КонецЕсли;
КонецПроцедуры

Процедура ПодготовитьНовый(Объект) Экспорт
	Если НЕ Объект.ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Состояние) Тогда
		Объект.Состояние = Перечисления.Расш1_СостоянияТЛ.Черновик;
	КонецЕсли;
	Если Объект.БазовоеКоличество = 0 Тогда
		Объект.БазовоеКоличество = 1;
	КонецЕсли;
КонецПроцедуры

// Пересчёт черновика обновляет только автоматические строки. Дополнительные
// материалы в отдельной таблице остаются под управлением технолога.
Функция Пересчитать(Объект, Строго = Ложь) Экспорт
	ПроверитьПравоРедактирования();
	Если Объект.Состояние <> Перечисления.Расш1_СостоянияТЛ.Черновик
		И НЕ Строго Тогда
		ВызватьИсключение "Утверждённый технический лист не пересчитывается. Создайте новую редакцию.";
	КонецЕсли;
	ОбеспечитьИдентификаторы(Объект);
	Результат = Расш1_МатериалыТЛРасчет.Рассчитать(ПараметрыРасчета(Объект),
		ОперацииРасчета(Объект), ПравилаРасчета(), СлоиРасчета(Объект),
		КоннекторыРасчета(Объект), СтарыеМатериалы(Объект));
	Объект.ОшибкиРасчета = СтрСоединить(Результат.Ошибки, Символы.ПС);
	Если Результат.Ошибки.Количество() > 0 Тогда
		Если Строго Тогда
			ВызватьИсключение Объект.ОшибкиРасчета;
		КонецЕсли;
		// Временная незаполненность поля не уничтожает ручную корректировку
		// прежней расчётной строки. Состав с ошибками нельзя переносить в УНФ.
		Возврат Объект.ОшибкиРасчета;
	КонецЕсли;
	Объект.Материалы.Очистить();
	Для Каждого Материал Из Результат.Материалы Цикл
		Если Материал.Автоматически Тогда
			СтрокаМатериала = Объект.Материалы.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаМатериала, Материал);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Результат.Ошибки, Символы.ПС);
КонецФункции

// Вызывается из модуля объекта внутри транзакции записи, в том числе при
// программной записи в обход формы. Утверждённые редакции неизменяемы.
Процедура ПередЗаписьюТехЛиста(Объект) Экспорт
	ПроверитьПравоРедактирования();
	Если НЕ Объект.ЭтоНовый() Тогда
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("Справочник.Расш1_ТехническиеЛисты");
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		Элемент.УстановитьЗначение("Ссылка", Объект.Ссылка);
		Блокировка.Заблокировать();
		Прежний = Объект.Ссылка.ПолучитьОбъект();
		Если Прежний.Состояние = Перечисления.Расш1_СостоянияТЛ.Утвержден Тогда
			ВызватьИсключение "Утверждённая редакция защищена от изменения. Используйте «Создать редакцию».";
		КонецЕсли;
		// Эти значения нельзя менять даже программной записью черновика.
		ЗаполнитьЗначенияСвойств(Объект, Прежний,
			"ЛинияРедакций,Редакция,ПредыдущаяРедакция,ИсходныйТехЛист,Автор,ДатаСоздания");
	Иначе
		НазначитьРедакцию(Объект);
		Объект.Автор = ИмяТекущегоПользователя();
		Объект.ДатаСоздания = ТекущаяДатаСеанса();
	КонецЕсли;
	Если Объект.ПометкаУдаления Тогда
		Если Объект.Состояние = Перечисления.Расш1_СостоянияТЛ.Утвержден Тогда
			ВызватьИсключение "Утверждённый технический лист нельзя пометить на удаление.";
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ПредыдущаяРедакция) Тогда
		ПроверитьНазначениеРедакции(Объект, Объект.ПредыдущаяРедакция.ПолучитьОбъект());
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Состояние) Тогда
		Объект.Состояние = Перечисления.Расш1_СостоянияТЛ.Черновик;
	КонецЕсли;
	Если Объект.Индивидуальный Тогда
		ПроверитьСтрокуЗаказа(Объект.Заказ, Объект.НомерСтрокиЗаказа,
			Объект.Номенклатура, Объект.Характеристика);
	ИначеЕсли ЗначениеЗаполнено(Объект.Заказ) ИЛИ Объект.НомерСтрокиЗаказа <> 0 Тогда
		ВызватьИсключение "У типового технического листа не указывается конкретный заказ.";
	КонецЕсли;
	Утверждение = Объект.Состояние = Перечисления.Расш1_СостоянияТЛ.Утвержден;
	Если Утверждение Тогда
		ПроверитьУтверждение(Объект);
	КонецЕсли;
	Пересчитать(Объект, Утверждение);
	Если Утверждение Тогда
		Расш1_СпецификацииТЛСервер.ЗафиксироватьСоставУНФ(Объект);
		Объект.ДатаУтверждения = ТекущаяДатаСеанса();
		Объект.Утвердил = ИмяТекущегоПользователя();
	Иначе
		Объект.СнимокСоставаУНФ = Неопределено;
		Объект.ДатаУтверждения = Дата(1, 1, 1);
		Объект.Утвердил = "";
	КонецЕсли;
КонецПроцедуры

Процедура ПередУдалениемТехЛиста(Объект) Экспорт
	ПроверитьПравоРедактирования();
	Хранимый = Объект.Ссылка.ПолучитьОбъект();
	Если Хранимый <> Неопределено И Хранимый.Состояние = Перечисления.Расш1_СостоянияТЛ.Утвержден Тогда
		ВызватьИсключение "Удаление утверждённого технического листа запрещено.";
	КонецЕсли;
КонецПроцедуры

Функция СоздатьРедакцию(Ссылка, Индивидуальный = Ложь, Заказ = Неопределено, НомерСтроки = 0) Экспорт
	ПроверитьПравоРедактирования();
	Исходный = Ссылка.ПолучитьОбъект();
	Если Исходный = Неопределено ИЛИ Исходный.ПометкаУдаления
		ИЛИ Исходный.Состояние <> Перечисления.Расш1_СостоянияТЛ.Утвержден Тогда
		ВызватьИсключение "Для копирования выберите утверждённый технический лист.";
	КонецЕсли;
	НовыйЛист = Исходный.Скопировать();
	СброситьУтверждениеКопии(НовыйЛист);
	Если Индивидуальный Тогда
		ПроверитьСтрокуЗаказа(Заказ, НомерСтроки, Исходный.Номенклатура, Исходный.Характеристика);
		НовыйЛист.Индивидуальный = Истина;
		НовыйЛист.Заказ = Заказ;
		НовыйЛист.НомерСтрокиЗаказа = НомерСтроки;
		НовыйЛист.ИсходныйТехЛист = Ссылка;
	Иначе
		НовыйЛист.ПредыдущаяРедакция = Ссылка;
	КонецЕсли;
	НовыйЛист.Записать();
	Возврат НовыйЛист.Ссылка;
КонецФункции

Процедура СброситьУтверждениеКопии(Объект) Экспорт
	Объект.Состояние = Перечисления.Расш1_СостоянияТЛ.Черновик;
	Объект.ЛинияРедакций = "";
	Объект.Редакция = 0;
	Объект.ПредыдущаяРедакция = Справочники.Расш1_ТехническиеЛисты.ПустаяСсылка();
	Объект.Утвердил = "";
	Объект.ДатаУтверждения = Дата(1, 1, 1);
	Объект.СнимокСоставаУНФ = Неопределено;
	Объект.ОшибкиРасчета = "";
КонецПроцедуры

Функция ДанныеОперации(Ссылка, ПроверятьПометку = Истина) Экспорт
	Результат = Новый Структура("ВидОперации,Участок,РаботаУНФ,НормаВремениМин",
		Перечисления.Расш1_ВидыОперацийТЛ.ПустаяСсылка(), Справочники.Участки.ПустаяСсылка(),
		Справочники.Номенклатура.ПустаяСсылка(), 0);
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Результат;
	КонецЕсли;
	ОбъектОперации = Ссылка.ПолучитьОбъект();
	Если ОбъектОперации = Неопределено Тогда
		ВызватьИсключение "Операция удалена или не существует.";
	КонецЕсли;
	Если ПроверятьПометку И ОбъектОперации.ПометкаУдаления Тогда
		ВызватьИсключение "Операция помечена на удаление.";
	КонецЕсли;
	ЗаполнитьОперациюПоУмолчанию(ОбъектОперации);
	ЗаполнитьЗначенияСвойств(Результат, ОбъектОперации);
	Возврат Результат;
КонецФункции

// Работает и с ещё не записанным объектом: участок соответствует выбранному
// виду, а не прежнему состоянию элемента в базе.
Процедура ЗаполнитьОперациюПоУмолчанию(ОбъектОперации) Экспорт
	Если ЗначениеЗаполнено(ОбъектОперации.ИмяПредопределенныхДанных) Тогда
		Для Индекс = 0 По Перечисления.Расш1_ВидыОперацийТЛ.Количество() - 1 Цикл
			Если Метаданные.Перечисления.Расш1_ВидыОперацийТЛ.ЗначенияПеречисления[Индекс].Имя
				= ОбъектОперации.ИмяПредопределенныхДанных Тогда
				ОбъектОперации.ВидОперации = Перечисления.Расш1_ВидыОперацийТЛ.Получить(Индекс);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ОбъектОперации.Участок) Тогда
		Вид = КодПеречисления("Расш1_ВидыОперацийТЛ", ОбъектОперации.ВидОперации);
		Если Вид = "Резка" Тогда
			ОбъектОперации.Участок = Справочники.Участки.Резка;
		ИначеЕсли Вид = "ГАР" Тогда
			ОбъектОперации.Участок = Справочники.Участки.ГАР;
		ИначеЕсли Вид = "Кромка" Тогда
			ОбъектОперации.Участок = Справочники.Участки.Центра;
		ИначеЕсли Вид = "Сверловка" Тогда
			ОбъектОперации.Участок = Справочники.Участки.Сверловка;
		ИначеЕсли Вид = "Контроль" Тогда
			ОбъектОперации.Участок = Справочники.Участки.Контроль;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьПравилоМатериалов(Объект) Экспорт
	ПроверитьПравоРедактирования();
	Если НЕ Объект.Использовать ИЛИ Объект.ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(Объект.Наименование) ИЛИ НЕ ЗначениеЗаполнено(Объект.Операция) ИЛИ НЕ ЗначениеЗаполнено(Объект.ИсточникМатериала)
		ИЛИ НЕ ЗначениеЗаполнено(Объект.СпособРасчета) ИЛИ Объект.Норма <= 0 Тогда
		ВызватьИсключение "У активного правила заполните наименование, операцию, источник материала, способ расчёта и положительную норму.";
	КонецЕсли;
	Источник = КодПеречисления("Расш1_ИсточникиМатериаловТЛ", Объект.ИсточникМатериала);
	Способ = КодПеречисления("Расш1_РасчетМатериаловТЛ", Объект.СпособРасчета);
	Если Источник = "Фиксированный" И НЕ ЗначениеЗаполнено(Объект.Номенклатура) Тогда
		ВызватьИсключение "Выберите фиксированный материал правила.";
	КонецЕсли;
	Если (Источник = "Коннектор" И Способ <> "НаКоннектор")
		ИЛИ (Источник = "Краска" И Способ <> "НаПлощадьПечати" И Способ <> "НаСлой")
		ИЛИ (Источник = "Стекло" И Способ <> "НаИзделие" И Способ <> "НаПлощадьИзделия" И Способ <> "НаПлощадьЗаготовки") Тогда
		ВызватьИсключение "Способ расчёта не соответствует источнику материала.";
	КонецЕсли;
	Если Объект.ТолщинаДоМм > 0 И Объект.ТолщинаОтМм > Объект.ТолщинаДоМм Тогда
		ВызватьИсключение "Нижняя граница толщины превышает верхнюю.";
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ВидСлоя) И Способ <> "НаПлощадьПечати" И Способ <> "НаСлой" Тогда
		ВызватьИсключение "Условие по виду слоя применяется к расчёту на слой или площадь печати.";
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьСтрокуЗаказа(Заказ, НомерСтроки, Номенклатура, Характеристика) Экспорт
	Если НЕ ЗначениеЗаполнено(Заказ) ИЛИ НомерСтроки <= 0 Тогда
		ВызватьИсключение "У индивидуального техлиста укажите заказ и строку продукции.";
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ Продукция.Номенклатура КАК Номенклатура, Продукция.Характеристика КАК Характеристика
		|ИЗ Документ.ЗаказНаПроизводство.Продукция КАК Продукция
		|ГДЕ Продукция.Ссылка = &Заказ И Продукция.НомерСтроки = &Строка
		| И НЕ Продукция.Ссылка.ПометкаУдаления");
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Запрос.УстановитьПараметр("Строка", НомерСтроки);
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		ВызватьИсключение "Строка продукции не найдена в заказе.";
	КонецЕсли;
	Если Выборка.Номенклатура <> Номенклатура ИЛИ Выборка.Характеристика <> Характеристика Тогда
		ВызватьИсключение "Изделие или характеристика техлиста не соответствует строке заказа.";
	КонецЕсли;
КонецПроцедуры

Функция СтрокиЗаказаДляВыбора(Заказ) Экспорт
	ПроверитьПравоРедактирования();
	Запрос = Новый Запрос(
		"ВЫБРАТЬ Продукция.НомерСтроки КАК НомерСтроки,
		| Продукция.Номенклатура КАК Номенклатура, Продукция.Характеристика КАК Характеристика
		|ИЗ Документ.ЗаказНаПроизводство.Продукция КАК Продукция
		|ГДЕ Продукция.Ссылка = &Заказ И НЕ Продукция.Ссылка.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО НомерСтроки");
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Список = Новый СписокЗначений;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Список.Добавить(Выборка.НомерСтроки, Строка(Выборка.НомерСтроки) + ": "
			+ Строка(Выборка.Номенклатура) + " / " + Строка(Выборка.Характеристика));
	КонецЦикла;
	Возврат Список;
КонецФункции

// Сводные нормы в базовых единицах материалов. Это плановый состав:
// функция не создаёт движений склада и не изменяет типовую спецификацию.
Функция МатериалыТехЛиста(Ссылка) Экспорт
	Объект = Ссылка.ПолучитьОбъект();
	Если Объект = Неопределено ИЛИ Объект.ПометкаУдаления Тогда
		ВызватьИсключение "Технический лист не найден.";
	КонецЕсли;
	Если НЕ ПустаяСтрока(Объект.ОшибкиРасчета) Тогда
		ВызватьИсключение "Завершите расчёт материалов техлиста: " + Объект.ОшибкиРасчета;
	КонецЕсли;
	Возврат Расш1_МатериалыТЛРасчет.СводныйСостав(СтарыеМатериалы(Объект));
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИмяТекущегоПользователя()
	Возврат ПользователиИнформационнойБазы.ТекущийПользователь().Имя;
КонецФункции

Функция КлючСсылки(Ссылка)
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат "";
	КонецЕсли;
	Возврат Строка(Ссылка.УникальныйИдентификатор());
КонецФункции

Функция КлючМатериала(Номенклатура, Характеристика)
	Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат "";
	КонецЕсли;
	Возврат КлючСсылки(Номенклатура) + "/" + КлючСсылки(Характеристика);
КонецФункции

Функция КодПеречисления(Имя, Значение)
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;
	Индекс = Перечисления[Имя].Индекс(Значение);
	Возврат Метаданные.Перечисления[Имя].ЗначенияПеречисления[Индекс].Имя;
КонецФункции

Процедура ОбеспечитьИдентификаторы(Объект)
	Для Каждого Имя Из СтрРазделить("Операции,Отверстия,СлоиПечати,Коннекторы,Файлы", ",") Цикл
		Использованные = Новый Соответствие;
		Для Каждого СтрокаТаблицы Из Объект[Имя] Цикл
			Если ПустаяСтрока(СтрокаТаблицы.Идентификатор)
				ИЛИ Использованные.Получить(СтрокаТаблицы.Идентификатор) <> Неопределено Тогда
				СтрокаТаблицы.Идентификатор = Строка(Новый УникальныйИдентификатор);
			КонецЕсли;
			Использованные.Вставить(СтрокаТаблицы.Идентификатор, Истина);
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

Функция ПараметрыРасчета(Объект)
	Параметры = Новый Структура;
	Параметры.Вставить("БазовоеКоличество", Объект.БазовоеКоличество);
	Параметры.Вставить("Ширина", Объект.ШиринаМм);
	Параметры.Вставить("Высота", Объект.ВысотаМм);
	Параметры.Вставить("Толщина", Объект.ТолщинаМм);
	Параметры.Вставить("Цвет", КлючСсылки(Объект.ЦветСтекла));
	Параметры.Вставить("Припуск", Объект.ПрипускРезкиМм);
	Параметры.Вставить("ПлощадьИзделия", Объект.ПлощадьИзделияМ2);
	Параметры.Вставить("ПлощадьЗаготовки", Объект.ПлощадьЗаготовкиМ2);
	Параметры.Вставить("Периметр", Объект.ПериметрМ);
	Параметры.Вставить("Отверстий", Объект.Отверстия.Итог("Количество"));
	Параметры.Вставить("МатериалСтекла", Объект.МатериалСтекла);
	Параметры.Вставить("ХарактеристикаСтекла", Объект.ХарактеристикаСтекла);
	Параметры.Вставить("КлючСтекла", КлючМатериала(Объект.МатериалСтекла, Объект.ХарактеристикаСтекла));
	Возврат Параметры;
КонецФункции

Функция ОперацииРасчета(Объект)
	Результат = Новый Массив;
	Для Каждого СтрокаТаблицы Из Объект.Операции Цикл
		Результат.Добавить(Новый Структура("ИД,Операция,Использовать",
			СтрокаТаблицы.Идентификатор, СтрокаТаблицы.Операция, СтрокаТаблицы.Использовать));
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ПравилаРасчета()
	Запрос = Новый Запрос("ВЫБРАТЬ Правила.Ссылка КАК Ссылка,
		| Правила.Наименование КАК Наименование, Правила.Операция КАК Операция,
		| Правила.ИсточникМатериала КАК ИсточникМатериала, Правила.СпособРасчета КАК СпособРасчета,
		| Правила.Номенклатура КАК Номенклатура, Правила.Характеристика КАК Характеристика,
		| Правила.Норма КАК Норма, Правила.ПроцентПотерь КАК ПроцентПотерь,
		| Правила.ТолщинаОтМм КАК ТолщинаОтМм, Правила.ТолщинаДоМм КАК ТолщинаДоМм,
		| Правила.ЦветСтекла КАК ЦветСтекла, Правила.ВидСлоя КАК ВидСлоя
		|ИЗ Справочник.Расш1_ПравилаМатериаловТЛ КАК Правила
		|ГДЕ Правила.Использовать И НЕ Правила.ПометкаУдаления");
	Выборка = Запрос.Выполнить().Выбрать();
	Результат = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Правило = Выборка;
		Данные = Новый Структура;
		Данные.Вставить("ИД", КлючСсылки(Выборка.Ссылка));
		Данные.Вставить("Наименование", Правило.Наименование);
		Данные.Вставить("Ссылка", Выборка.Ссылка);
		Данные.Вставить("Операция", Правило.Операция);
		Данные.Вставить("Источник", КодПеречисления("Расш1_ИсточникиМатериаловТЛ", Правило.ИсточникМатериала));
		Данные.Вставить("Способ", КодПеречисления("Расш1_РасчетМатериаловТЛ", Правило.СпособРасчета));
		Данные.Вставить("Номенклатура", Правило.Номенклатура);
		Данные.Вставить("Характеристика", Правило.Характеристика);
		Данные.Вставить("КлючМатериала", КлючМатериала(Правило.Номенклатура, Правило.Характеристика));
		Данные.Вставить("Норма", Правило.Норма);
		Данные.Вставить("Потери", Правило.ПроцентПотерь);
		Данные.Вставить("ТолщинаОт", Правило.ТолщинаОтМм);
		Данные.Вставить("ТолщинаДо", Правило.ТолщинаДоМм);
		Данные.Вставить("Цвет", КлючСсылки(Правило.ЦветСтекла));
		Данные.Вставить("ВидСлоя", КодПеречисления("Расш1_ВидыСлоевТЛ", Правило.ВидСлоя));
		Результат.Добавить(Данные);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция СлоиРасчета(Объект)
	Результат = Новый Массив;
	Для Каждого Слой Из Объект.СлоиПечати Цикл
		Данные = Новый Структура("ИД,Использовать,ВидСлоя,Материал,Характеристика,КлючМатериала,Процент",
			Слой.Идентификатор, Слой.Использовать, КодПеречисления("Расш1_ВидыСлоевТЛ", Слой.ВидСлоя),
			Слой.Материал, Слой.Характеристика, КлючМатериала(Слой.Материал, Слой.Характеристика), Слой.ПроцентНанесения);
		Результат.Добавить(Данные);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция КоннекторыРасчета(Объект)
	Результат = Новый Массив;
	Для Каждого Коннектор Из Объект.Коннекторы Цикл
		Результат.Добавить(Новый Структура("ИД,Номенклатура,Характеристика,КлючМатериала,Количество",
			Коннектор.Идентификатор, Коннектор.Номенклатура, Коннектор.Характеристика,
			КлючМатериала(Коннектор.Номенклатура, Коннектор.Характеристика), Коннектор.Количество));
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция СтарыеМатериалы(Объект)
	Результат = Новый Массив;
	Для Каждого Материал Из Объект.Материалы Цикл
		Данные = Новый Структура("Номенклатура,Характеристика,Количество,Корректировка,Автоматически,КлючРасчета,КлючМатериала",
			Материал.Номенклатура, Материал.Характеристика, Материал.Количество, Материал.Корректировка,
			Истина, Материал.КлючРасчета, КлючМатериала(Материал.Номенклатура, Материал.Характеристика));
		Результат.Добавить(Данные);
	КонецЦикла;
	Для Каждого Материал Из Объект.РучныеМатериалы Цикл
		Результат.Добавить(Новый Структура("Номенклатура,Характеристика,Количество,Автоматически,КлючМатериала",
			Материал.Номенклатура, Материал.Характеристика, Материал.Количество, Ложь,
			КлючМатериала(Материал.Номенклатура, Материал.Характеристика)));
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура НазначитьРедакцию(Объект)
	Объект.ЛинияРедакций = Строка(Новый УникальныйИдентификатор);
	Если ЗначениеЗаполнено(Объект.ПредыдущаяРедакция) Тогда
		Предыдущая = Объект.ПредыдущаяРедакция.ПолучитьОбъект();
		Если Предыдущая = Неопределено ИЛИ Предыдущая.ПометкаУдаления
			ИЛИ Предыдущая.Состояние <> Перечисления.Расш1_СостоянияТЛ.Утвержден Тогда
			ВызватьИсключение "Предыдущая редакция должна быть утверждена.";
		КонецЕсли;
		ПроверитьНазначениеРедакции(Объект, Предыдущая);
		Объект.ЛинияРедакций = Предыдущая.ЛинияРедакций;
	КонецЕсли;
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрСведений.Расш1_РедакцииТЛ");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Элемент.УстановитьЗначение("ЛинияРедакций", Объект.ЛинияРедакций);
	Блокировка.Заблокировать();
	Запись = РегистрыСведений.Расш1_РедакцииТЛ.СоздатьМенеджерЗаписи();
	Запись.ЛинияРедакций = Объект.ЛинияРедакций;
	Запись.Прочитать();
	Если Запись.ПоследняяРедакция >= 999999999 Тогда
		ВызватьИсключение "Исчерпан диапазон номеров редакций.";
	КонецЕсли;
	Объект.Редакция = Запись.ПоследняяРедакция + 1;
	Запись.ЛинияРедакций = Объект.ЛинияРедакций;
	Запись.ПоследняяРедакция = Объект.Редакция;
	Запись.Записать();
КонецПроцедуры

Процедура ПроверитьНазначениеРедакции(Объект, Предыдущая)
	Если Предыдущая = Неопределено Тогда
		ВызватьИсключение "Предыдущая редакция не найдена.";
	КонецЕсли;
	Если Предыдущая.Номенклатура <> Объект.Номенклатура ИЛИ Предыдущая.Характеристика <> Объект.Характеристика
		ИЛИ Предыдущая.Индивидуальный <> Объект.Индивидуальный ИЛИ Предыдущая.Заказ <> Объект.Заказ
		ИЛИ Предыдущая.НомерСтрокиЗаказа <> Объект.НомерСтрокиЗаказа Тогда
		ВызватьИсключение "Редакция должна относиться к тому же изделию и назначению.";
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьУтверждение(Объект)
	Если Объект.ПометкаУдаления ИЛИ НЕ ЗначениеЗаполнено(Объект.Номенклатура)
		ИЛИ Объект.Номенклатура.ПометкаУдаления ИЛИ ПустаяСтрока(Объект.Наименование) Тогда
		ВызватьИсключение "Для утверждения заполните наименование и действующее изделие.";
	КонецЕсли;
	Если Объект.ШиринаМм <= 0 ИЛИ Объект.ВысотаМм <= 0 ИЛИ Объект.ТолщинаМм <= 0 Тогда
		ВызватьИсключение "Для утверждения укажите положительные размеры и толщину стекла.";
	КонецЕсли;
	Если Объект.СопротивлениеДоОм > 0 И Объект.СопротивлениеОтОм > Объект.СопротивлениеДоОм Тогда
		ВызватьИсключение "Нижняя граница сопротивления превышает верхнюю.";
	КонецЕсли;
	КоличествоОпераций = 0;
	Для Каждого Операция Из Объект.Операции Цикл
		Если НЕ Операция.Использовать Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Операция.Операция) ИЛИ НЕ ЗначениеЗаполнено(Операция.Участок)
			ИЛИ Операция.Участок.ПометкаУдаления Тогда
			ВызватьИсключение "У каждой включённой операции выберите операцию и действующий участок.";
		КонецЕсли;
		Данные = ДанныеОперации(Операция.Операция);
		Если НЕ ЗначениеЗаполнено(Данные.ВидОперации) Тогда
			ВызватьИсключение "У операции не заполнен вид операции.";
		КонецЕсли;
		КоличествоОпераций = КоличествоОпераций + 1;
	КонецЦикла;
	Если КоличествоОпераций = 0 Тогда
		ВызватьИсключение "Добавьте хотя бы одну включённую операцию в маршрут.";
	КонецЕсли;
	Для Каждого Слой Из Объект.СлоиПечати Цикл
		Если Слой.Использовать И (НЕ ЗначениеЗаполнено(Слой.ВидСлоя) ИЛИ Слой.ПроцентНанесения <= 0
			ИЛИ Слой.ПроцентНанесения > 100) Тогда
			ВызватьИсключение "У включённого слоя выберите вид и процент нанесения больше 0 и не больше 100.";
		КонецЕсли;
	КонецЦикла;
	Для Каждого Коннектор Из Объект.Коннекторы Цикл
		Если НЕ ЗначениеЗаполнено(Коннектор.Номенклатура) ИЛИ Коннектор.Количество <= 0 Тогда
			ВызватьИсключение "У каждого коннектора выберите номенклатуру и положительное количество.";
		КонецЕсли;
	КонецЦикла;
	Для Каждого Отверстие Из Объект.Отверстия Цикл
		Если Отверстие.Количество <= 0 ИЛИ Отверстие.ДиаметрМм <= 0 Тогда
			ВызватьИсключение "У отверстий укажите положительные количество и диаметр.";
		КонецЕсли;
	КонецЦикла;
	Для Каждого Материал Из Объект.РучныеМатериалы Цикл
		Если НЕ ЗначениеЗаполнено(Материал.Номенклатура) ИЛИ Материал.Количество <= 0 Тогда
			ВызватьИсключение "У дополнительного материала заполните номенклатуру и положительную норму.";
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти
