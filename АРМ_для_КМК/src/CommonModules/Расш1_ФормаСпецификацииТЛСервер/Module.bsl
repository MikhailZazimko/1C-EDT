#Область ПрограммныйИнтерфейс

// Геометрия типовой формы наследуется из УНФ. Все новые элементы имеют свой
// префикс; типовые реквизиты, события и дополнительные колонки не заменяются.
Процедура ДобавитьЭлементы(Форма) Экспорт
	Если Форма.Элементы.Найти("Расш1_ТЛСтраница") <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Шапка = Форма.Элементы.Найти("ГруппаЛеваяКолонка");
	Страницы = Форма.Элементы.Найти("Страницы");
	Если Шапка = Неопределено ИЛИ Страницы = Неопределено Тогда
		ВызватьИсключение "Изменилась структура формы спецификации УНФ: не найдена шапка или группа страниц техлиста.";
	КонецЕсли;
	Реквизиты = Новый Массив;
	Реквизиты.Добавить(Новый РеквизитФормы("Расш1_ДанныеТЛ",
		Новый ОписаниеТипов("СправочникОбъект.Расш1_ТехническиеЛисты"), , , Истина));
	Реквизиты.Добавить(Новый РеквизитФормы("Расш1_ОткрытаяРедакцияТЛ",
		Новый ОписаниеТипов("СправочникСсылка.Расш1_ТехническиеЛисты")));
	Реквизиты.Добавить(Новый РеквизитФормы("Расш1_ИзмененТЛ", Новый ОписаниеТипов("Булево")));
	Реквизиты.Добавить(Новый РеквизитФормы("Расш1_ПрочитанноеСостояниеТЛ",
		Новый ОписаниеТипов("ПеречислениеСсылка.Расш1_СостоянияТЛ")));
	Реквизиты.Добавить(Новый РеквизитФормы("Расш1_СообщениеТЛ", Новый ОписаниеТипов("Строка")));
	Форма.ИзменитьРеквизиты(Реквизиты);
	Флажок = Поле(Форма, Шапка, "Расш1_ТЛФлажок", "Технический лист",
		"Объект.Расш1_ЭтоТехническийЛист", Истина);
	Флажок.УстановитьДействие("ПриИзменении", "Расш1_ТЛФлажокПриИзменении");
	Страница = Группа(Форма, Страницы, "Расш1_ТЛСтраница", "Технический лист", ВидГруппыФормы.Страница);
	Ссылка = Поле(Форма, Страница, "Расш1_ТЛРедакция", "Редакция техлиста",
		"Объект.Расш1_ТехническийЛист");
	Ссылка.УстановитьДействие("ПриИзменении", "Расш1_ТЛРедакцияПриИзменении");
	Панель = Группа(Форма, Страница, "Расш1_ТЛКоманды", "", ВидГруппыФормы.ОбычнаяГруппа);
	Панель.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяЕслиВозможно;
	Для Каждого Команда Из КомандыТехЛиста() Цикл
		НоваяКоманда = Форма.Команды.Добавить(Команда.Имя);
		НоваяКоманда.Заголовок = Команда.Заголовок;
		НоваяКоманда.Действие = Команда.Имя;
		Кнопка = Форма.Элементы.Добавить(Команда.Имя, Тип("КнопкаФормы"), Панель);
		Кнопка.ИмяКоманды = Команда.Имя;
	КонецЦикла;
	Сообщение = Поле(Форма, Страница, "Расш1_ТЛСообщение", "", "Расш1_СообщениеТЛ");
	Сообщение.Вид = ВидПоляФормы.ПолеНадписи;
	Вкладки = Группа(Форма, Страница, "Расш1_ТЛРазделы", "", ВидГруппыФормы.Страницы);
	Счетчик = 0;
	Для Каждого Раздел Из Расш1_СхемаТЛСервер.Разделы() Цикл
		Счетчик = Счетчик + 1;
		ДобавитьРаздел(Форма, Вкладки, Раздел, Счетчик);
	КонецЦикла;
	Для Каждого Таблица Из Метаданные.Справочники.Расш1_ТехническиеЛисты.ТабличныеЧасти Цикл
		СтраницаТаблицы = Группа(Форма, Вкладки, "Расш1_ТЛСтраница" + Таблица.Имя,
			Таблица.Синоним, ВидГруппыФормы.Страница);
		ДобавитьТаблицу(Форма, СтраницаТаблицы, Таблица);
	КонецЦикла;
КонецПроцедуры

Процедура ОбновитьДоступность(Форма, Лист) Экспорт
	Редактор = Расш1_ТехническиеЛистыСервер.МожноРедактировать();
	Черновик = Лист.Состояние <> Перечисления.Расш1_СостоянияТЛ.Утвержден;
	Форма.Элементы.Расш1_ТЛСтраница.Видимость = Форма.Объект.Расш1_ЭтоТехническийЛист;
	Форма.Элементы.Расш1_ТЛФлажок.ТолькоПросмотр = НЕ Редактор;
	Форма.Элементы.Расш1_ТЛРедакция.ТолькоПросмотр = НЕ Редактор;
	Для Каждого Элемент Из Форма.Элементы Цикл
		Если Лев(Элемент.Имя, 8) <> "Расш1_ТЛ" Тогда
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(Элемент) = Тип("ПолеФормы") И Лев(Элемент.ПутьКДанным, 15) = "Расш1_ДанныеТЛ." Тогда
			Имя = СтрЗаменить(Элемент.ПутьКДанным, "Расш1_ДанныеТЛ.", "");
			Элемент.ТолькоПросмотр = НЕ Редактор ИЛИ НЕ Черновик ИЛИ ЗащищенноеПоле(Имя);
		ИначеЕсли ТипЗнч(Элемент) = Тип("ТаблицаФормы") Тогда
			Элемент.ТолькоПросмотр = НЕ Редактор ИЛИ НЕ Черновик;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("Пересчитать,Утвердить,ПрикрепитьФайл", ",") Цикл
		Форма.Элементы["Расш1_ТЛ" + Имя].Видимость = Редактор И Черновик;
	КонецЦикла;
	Форма.Элементы.Расш1_ТЛНоваяРедакция.Видимость = Редактор И НЕ Черновик;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КомандыТехЛиста()
	Результат = Новый Массив;
	Результат.Добавить(Новый Структура("Имя,Заголовок", "Расш1_ТЛПересчитать", "Пересчитать состав"));
	Результат.Добавить(Новый Структура("Имя,Заголовок", "Расш1_ТЛУтвердить", "Утвердить и записать"));
	Результат.Добавить(Новый Структура("Имя,Заголовок", "Расш1_ТЛНоваяРедакция", "Создать редакцию"));
	Результат.Добавить(Новый Структура("Имя,Заголовок", "Расш1_ТЛОткрытьКарточку", "Открыть карточку"));
	Результат.Добавить(Новый Структура("Имя,Заголовок", "Расш1_ТЛПечать", "Печать техлиста"));
	Результат.Добавить(Новый Структура("Имя,Заголовок", "Расш1_ТЛПрикрепитьФайл", "Прикрепить файл"));
	Результат.Добавить(Новый Структура("Имя,Заголовок", "Расш1_ТЛСохранитьФайл", "Сохранить вложение"));
	Возврат Результат;
КонецФункции

Функция Группа(Форма, Родитель, Имя, Заголовок, Вид)
	Элемент = Форма.Элементы.Добавить(Имя, Тип("ГруппаФормы"), Родитель);
	Элемент.Вид = Вид;
	Элемент.Заголовок = Заголовок;
	Если Вид <> ВидГруппыФормы.Страницы Тогда
		Элемент.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	КонецЕсли;
	Возврат Элемент;
КонецФункции

Функция Поле(Форма, Родитель, Имя, Заголовок, Путь, Флажок = Ложь)
	Элемент = Форма.Элементы.Добавить(Имя, Тип("ПолеФормы"), Родитель);
	Элемент.Вид = ?(Флажок, ВидПоляФормы.ПолеФлажка, ВидПоляФормы.ПолеВвода);
	Элемент.ПутьКДанным = Путь;
	Элемент.Заголовок = Заголовок;
	Если НЕ Флажок Тогда
		Элемент.РедактированиеТекста = Истина;
	КонецЕсли;
	Возврат Элемент;
КонецФункции

Процедура ДобавитьРаздел(Форма, Вкладки, Раздел, Номер)
	Страница = Группа(Форма, Вкладки, "Расш1_ТЛРаздел" + Строка(Номер),
		Раздел.Заголовок, ВидГруппыФормы.Страница);
	Колонки = Группа(Форма, Страница, "Расш1_ТЛКолонки" + Строка(Номер), "", ВидГруппыФормы.ОбычнаяГруппа);
	Колонки.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяЕслиВозможно;
	Левая = Группа(Форма, Колонки, "Расш1_ТЛЛевая" + Строка(Номер), "", ВидГруппыФормы.ОбычнаяГруппа);
	Правая = Группа(Форма, Колонки, "Расш1_ТЛПравая" + Строка(Номер), "", ВидГруппыФормы.ОбычнаяГруппа);
	Поля = СтрРазделить(Раздел.Поля, ",");
	Для Индекс = 0 По Поля.Количество() - 1 Цикл
		Имя = Поля[Индекс];
		Реквизит = Метаданные.Справочники.Расш1_ТехническиеЛисты.Реквизиты.Найти(Имя);
		Родитель = ?(Индекс < Поля.Количество() / 2, Левая, Правая);
		Элемент = Поле(Форма, Родитель, "Расш1_ТЛПоле" + Имя, Реквизит.Синоним,
			"Расш1_ДанныеТЛ." + Имя, Реквизит.Тип.СодержитТип(Тип("Булево")));
		Если НЕ ЗащищенноеПоле(Имя) Тогда
			Элемент.УстановитьДействие("ПриИзменении", "Расш1_ТЛПараметрыПриИзменении");
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ДобавитьТаблицу(Форма, Родитель, МетаданныеТаблицы)
	Имя = МетаданныеТаблицы.Имя;
	Таблица = Форма.Элементы.Добавить("Расш1_ТЛТаблица" + Имя, Тип("ТаблицаФормы"), Родитель);
	Таблица.ПутьКДанным = "Расш1_ДанныеТЛ." + Имя;
	Таблица.ИзменятьСоставСтрок = Имя <> "Материалы";
	Таблица.ИзменятьПорядокСтрок = Имя <> "Материалы";
	Скрытые = СтрРазделить("Идентификатор,Данные,КлючРасчета,ИдентификаторОперации", ",");
	Для Каждого Реквизит Из МетаданныеТаблицы.Реквизиты Цикл
		Если Скрытые.Найти(Реквизит.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Элемент = Поле(Форма, Таблица, "Расш1_ТЛКолонка" + Имя + Реквизит.Имя, Реквизит.Синоним,
			"Расш1_ДанныеТЛ." + Имя + "." + Реквизит.Имя, Реквизит.Тип.СодержитТип(Тип("Булево")));
		Если НЕ ЗащищенноеПоле(Имя + "." + Реквизит.Имя) Тогда
			Элемент.УстановитьДействие("ПриИзменении", "Расш1_ТЛПараметрыПриИзменении");
		КонецЕсли;
	КонецЦикла;
	Если Имя <> "Материалы" Тогда
		Таблица.УстановитьДействие("ПриНачалеРедактирования", "Расш1_ТЛТаблицаПриНачалеРедактирования");
		Таблица.УстановитьДействие("ПослеУдаления", "Расш1_ТЛПараметрыПриИзменении");
	КонецЕсли;
КонецПроцедуры

Функция ЗащищенноеПоле(Имя)
	Если Лев(Имя, 10) = "Материалы." Тогда
		Возврат Имя <> "Материалы.Корректировка";
	КонецЕсли;
	Возврат СтрРазделить("Номенклатура,Характеристика,Состояние,Редакция,ПредыдущаяРедакция,ИсходныйТехЛист,Автор,ДатаСоздания,Утвердил,ДатаУтверждения", ",").Найти(Имя) <> Неопределено;
КонецФункции

#КонецОбласти
