#Область ПрограммныйИнтерфейс

// В УНФ у количества материала и количества продукции точность 3 знака.
// Масштабируем ОБЕ стороны нормы, сохраняя отношение. 0,000001 кг на 1 шт.
// становится 0,001 кг на 1000 шт., без потери малой нормы при округлении.
Функция НормаДляУНФ(Количество, База, МаксимумКоличества = 999999999999.999) Экспорт
	Если Количество < 0 ИЛИ База <= 0 Тогда
		ВызватьИсключение "Норма должна быть неотрицательной, количество продукции - положительным.";
	КонецЕсли;
	Для Индекс = 0 По 6 Цикл
		Если Окр(Количество, 3) = Количество И Окр(База, 3) = База Тогда
			Прервать;
		КонецЕсли;
		Количество = Количество * 10;
		База = База * 10;
	КонецЦикла;
	Если Окр(Количество, 3) <> Количество ИЛИ Окр(База, 3) <> База
		ИЛИ Количество > МаксимумКоличества ИЛИ База > 999999999999.999 Тогда
		ВызватьИсключение "Норму нельзя представить в точности и диапазоне типовой спецификации УНФ.";
	КонецЕсли;
	Возврат Новый Структура("Количество,КоличествоПродукции", Количество, База);
КонецФункции

// Время задаётся на базовое количество продукции, как и число операций.
// При увеличении базы сохраняется одна операция на одно изделие.
Функция НормаОперацииДляУНФ(МинутНаИзделие) Экспорт
	Норма = НормаДляУНФ(МинутНаИзделие, 60, 9999999.999);
	Возврат Новый Структура("Количество,КоличествоПродукции,НормаВремени",
		Норма.КоличествоПродукции, Норма.КоличествоПродукции, Норма.Количество);
КонецФункции

// Существующие: массив структур Ключ,Автоматически,ТекущийСнимок,
// СохраненныйСнимок,Строка. Желаемые: Ключ,Данные. Ссылки на строки непрозрачны.
// Ручные строки не попадают ни в одну изменяемую группу.
Функция ПланСинхронизации(Существующие, Желаемые) Экспорт
	План = Новый Структура("Добавить,Обновить,Удалить,Ошибки", Новый Массив, Новый Массив, Новый Массив, Новый Массив);
	Автоматические = Новый Соответствие;
	Для Каждого СтрокаСостава Из Существующие Цикл
		Если НЕ СтрокаСостава.Автоматически Тогда
			Продолжить;
		КонецЕсли;
		Если ПустаяСтрока(СтрокаСостава.Ключ) ИЛИ Автоматические.Получить(СтрокаСостава.Ключ) <> Неопределено Тогда
			План.Ошибки.Добавить("В составе повторяется автоматическая строка техлиста или потерян её источник.");
			Продолжить;
		КонецЕсли;
		Если ПустаяСтрока(СтрокаСостава.СохраненныйСнимок)
			ИЛИ СтрокаСостава.ТекущийСнимок <> СтрокаСостава.СохраненныйСнимок Тогда
			План.Ошибки.Добавить("Автоматическая строка изменена вручную. Изменяйте её норму в техлисте или добавьте отдельную ручную строку.");
		КонецЕсли;
		Автоматические.Вставить(СтрокаСостава.Ключ, СтрокаСостава);
	КонецЦикла;
	Использованные = Новый Соответствие;
	Для Каждого СтрокаПлана Из Желаемые Цикл
		Если Использованные.Получить(СтрокаПлана.Ключ) <> Неопределено Тогда
			План.Ошибки.Добавить("В расчётном составе повторяется ключ материала или операции.");
			Продолжить;
		КонецЕсли;
		Использованные.Вставить(СтрокаПлана.Ключ, Истина);
		Существующая = Автоматические.Получить(СтрокаПлана.Ключ);
		Если Существующая = Неопределено Тогда
			План.Добавить.Добавить(СтрокаПлана);
		Иначе
			План.Обновить.Добавить(Новый Структура("Строка,План", Существующая.Строка, СтрокаПлана));
		КонецЕсли;
	КонецЦикла;
	Для Каждого Элемент Из Автоматические Цикл
		Если Использованные.Получить(Элемент.Ключ) = Неопределено Тогда
			План.Удалить.Добавить(Элемент.Значение.Строка);
		КонецЕсли;
	КонецЦикла;
	Возврат План;
КонецФункции

#КонецОбласти
