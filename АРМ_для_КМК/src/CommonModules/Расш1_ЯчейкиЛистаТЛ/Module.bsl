#Область ПрограммныйИнтерфейс

// Изменяет одну ячейку по устойчивому идентификатору строки.
// Пустой идентификатор добавляет одну строку, не создавая пустых промежуточных.
//
// Параметры:
//  Таблица - Произвольный - Таблица исходных строк техлиста.
//  ИмяТаблицы - Строка - СлоиПечати, Отверстия или Коннекторы.
//  Идентификатор - Строка - Идентификатор изменяемой строки; пустой для новой.
//  Реквизит - Строка - Имя поля из описания ячеек листа.
//  Значение - Произвольный - Новое значение ячейки.
//
// Возвращаемое значение:
//  Строка - Идентификатор изменённой или созданной строки.
//
Функция ИзменитьЯчейку(Таблица, ИмяТаблицы, Идентификатор, Реквизит, Значение) Экспорт
	СтрокаТаблицы = Неопределено;
	Для Каждого Элемент Из Таблица Цикл
		Если Элемент.Идентификатор = Идентификатор И НЕ ПустаяСтрока(Идентификатор) Тогда
			СтрокаТаблицы = Элемент;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	НоваяСтрока = СтрокаТаблицы = Неопределено;
	Если НоваяСтрока Тогда
		Если НЕ ПустаяСтрока(Идентификатор) Тогда
			ВызватьИсключение "Строка технического листа удалена. Обновите представление листа.";
		КонецЕсли;
		СтрокаТаблицы = Таблица.Добавить();
		СтрокаТаблицы.Идентификатор = Строка(Новый УникальныйИдентификатор);
		Если ИмяТаблицы = "СлоиПечати" Тогда
			СтрокаТаблицы.Использовать = Истина;
			СтрокаТаблицы.ПроцентНанесения = 100;
		Иначе
			СтрокаТаблицы.Количество = 1;
			Если ИмяТаблицы = "Коннекторы" Тогда
				СтрокаТаблицы.КоличествоПаек = 1;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	СтрокаТаблицы[Реквизит] = Значение;
	Возврат СтрокаТаблицы.Идентификатор;
КонецФункции

// Сохраняет привязки колонок при редактировании и заполняет свободные места.
// Строки, не поместившиеся на основном листе, остаются в исходной таблице.
//
// Параметры:
//  Таблица - Произвольный - Исходные строки техлиста.
//  СтарыеПривязки - Массив из Строка - Идентификаторы строк в колонках формы.
//  Количество - Число - Количество видимых колонок.
//
// Возвращаемое значение:
//  Массив из Строка - Идентификаторы строк для отображения в колонках.
//
Функция ПривязкиКолонок(Таблица, СтарыеПривязки, Количество) Экспорт
	Результат = Новый Массив;
	Использованные = Новый Соответствие;
	Для Индекс = 0 По Количество - 1 Цикл
		ИД = "";
		Если СтарыеПривязки.Количество() > Индекс Тогда
			Для Каждого Элемент Из Таблица Цикл
				Если Элемент.Идентификатор = СтарыеПривязки[Индекс]
					И НЕ ПустаяСтрока(Элемент.Идентификатор)
					И Использованные.Получить(Элемент.Идентификатор) = Неопределено Тогда
					ИД = Элемент.Идентификатор;
					Использованные.Вставить(ИД, Истина);
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Результат.Добавить(ИД);
	КонецЦикла;
	Для Индекс = 0 По Количество - 1 Цикл
		Если НЕ ПустаяСтрока(Результат[Индекс]) Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Элемент Из Таблица Цикл
			Если НЕ ПустаяСтрока(Элемент.Идентификатор)
				И Использованные.Получить(Элемент.Идентификатор) = Неопределено Тогда
				Результат[Индекс] = Элемент.Идентификатор;
				Использованные.Вставить(Элемент.Идентификатор, Истина);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти
