#Область ПрограммныйИнтерфейс

// Связь задаётся явно: имя входа пользователя ИБ -> сотрудник.
// Справочники пользователей и физлиц основной конфигурации могут отличаться
// между версиями УНФ; совпадение отображаемых имён не является авторизацией.
Функция КонтекстРаботника() Экспорт

	ИмяВхода = ПользователиИнформационнойБазы.ТекущийПользователь().Имя;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		| Связь.Работник КАК Работник
		|ИЗ РегистрСведений.Расш1_РаботникиПользователей КАК Связь
		|ГДЕ Связь.ИмяПользователяИБ = &ИмяВхода");
	Запрос.УстановитьПараметр("ИмяВхода", ИмяВхода);
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		ВызватьИсключение "Не настроен работник для пользователя ИБ " + ИмяВхода
			+ ". Заполните регистр «Работники пользователей КМК».";
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Выборка.Работник) Тогда
		ВызватьИсключение "В сопоставлении пользователя ИБ не указан работник.";
	КонецЕсли;

	Если РольДоступна("Мастер") Тогда
		Роль = "Мастер";
	ИначеЕсли РольДоступна("Контролер") Тогда
		Роль = "Контролёр";
	ИначеЕсли РольДоступна("Оператор") Тогда
		Роль = "Оператор";
	Иначе
		ВызватьИсключение "Для рабочего места требуется роль Оператор, Мастер или Контролер.";
	КонецЕсли;

	Участки = Новый Массив;
	Если Роль = "Мастер" Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ Ссылка КАК Ссылка ИЗ Справочник.Участки ГДЕ НЕ ПометкаУдаления");
	ИначеЕсли Роль = "Контролёр" Тогда
		Участки.Добавить(Справочники.Участки.Контроль);
		Возврат Новый Структура("Работник,Роль,Участки", Выборка.Работник, Роль, Участки);
	Иначе
		Запрос = Новый Запрос(
			"ВЫБРАТЬ РАЗЛИЧНЫЕ Допуски.Участок КАК Ссылка
			|ИЗ РегистрСведений.ДопускиСотрудников КАК Допуски
			|ГДЕ Допуски.Сотрудник = &Работник
			| И Допуски.Разрешен
			| И НЕ Допуски.Участок.ПометкаУдаления");
		Запрос.УстановитьПараметр("Работник", Выборка.Работник);
	КонецЕсли;
	ВыборкаУчастков = Запрос.Выполнить().Выбрать();
	Пока ВыборкаУчастков.Следующий() Цикл
		Участки.Добавить(ВыборкаУчастков.Ссылка);
	КонецЦикла;
	Возврат Новый Структура("Работник,Роль,Участки", Выборка.Работник, Роль, Участки);

КонецФункции

Функция ПроверитьДоступКЗаказу(Заказ, Участок) Экспорт

	Контекст = КонтекстРаботника();
	Если НЕ ЗначениеЗаполнено(Заказ) ИЛИ НЕ ЗначениеЗаполнено(Участок) Тогда
		ВызватьИсключение "Не указан заказ или производственный участок.";
	КонецЕсли;
	Если Контекст.Участки.Найти(Участок) = Неопределено Тогда
		ВызватьИсключение "Нет допуска к выбранному производственному участку.";
	КонецЕсли;
	Если Заказ.ПометкаУдаления ИЛИ Заказ.Участок <> Участок Тогда
		ВызватьИсключение "Заказ удалён или его участок изменён. Обновите журнал.";
	КонецЕсли;
	Возврат Контекст;

КонецФункции

Функция СтатусПоКоличеству(План, Выполнено) Экспорт

	Если Выполнено = 0 Тогда
		Возврат "К выполнению";
	ИначеЕсли Выполнено < План Тогда
		Возврат "В работе";
	КонецЕсли;
	Возврат "Выполнен";

КонецФункции

Функция ОстатокСтроки(План, ВыполненоРанее, ВыполненоСейчас, Брак) Экспорт
	Возврат План - ВыполненоРанее - ВыполненоСейчас - Брак;
КонецФункции

// Одна строка результата соответствует строке продукции заказа.
// Состояние типового заказа не используется и не изменяется.
Функция СтрокиЗаказов(Заказ = Неопределено, ИсключаемыйРегистратор = Неопределено) Экспорт

	Контекст = КонтекстРаботника();
	Если ИсключаемыйРегистратор = Неопределено Тогда
		ИсключаемыйРегистратор = Документы.Выработка.ПустаяСсылка();
	КонецЕсли;
	Если Заказ = Неопределено Тогда
		Заказ = Документы.ЗаказНаПроизводство.ПустаяСсылка();
	КонецЕсли;
	ПроверитьИсторическиеДвижения(Контекст.Участки, Заказ, ИсключаемыйРегистратор);
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		| Прод.Ссылка КАК Заказ,
		| Прод.Ссылка.Номер КАК НомерЗаказа,
		| Прод.Ссылка.Дата КАК ДатаЗаказа,
		| Прод.Ссылка.Участок КАК Участок,
		| Прод.НомерСтроки КАК НомерСтрокиЗаказа,
		| Прод.Номенклатура КАК Номенклатура,
		| Прод.Характеристика КАК Характеристика,
		| Прод.Количество КАК План,
		| СУММА(ЕСТЬNULL(Итоги.Выполнено, 0)) КАК Выполнено
		|ИЗ Документ.ЗаказНаПроизводство.Продукция КАК Прод
		| ЛЕВОЕ СОЕДИНЕНИЕ (
		|  ВЫБРАТЬ Рег.Заказ КАК Заказ, Рег.Участок КАК Участок,
		|   Рег.Расш1_НомерСтрокиЗаказа КАК Расш1_НомерСтрокиЗаказа,
		|   Рег.Номенклатура КАК Номенклатура, Рег.Характеристика КАК Характеристика,
		|   СУММА(Рег.Выполнено) КАК Выполнено
		|  ИЗ РегистрНакопления.ВыработкаПоЗаказам КАК Рег
		|  ГДЕ Рег.Активность И Рег.Регистратор <> &ИсключаемыйРегистратор
		|   И Рег.Участок В (&Участки)
		|   И (&ВсеЗаказы ИЛИ Рег.Заказ = &Заказ)
		|  СГРУППИРОВАТЬ ПО Рег.Заказ, Рег.Участок, Рег.Расш1_НомерСтрокиЗаказа,
		|   Рег.Номенклатура, Рег.Характеристика
		| ) КАК Итоги
		| ПО Итоги.Заказ = Прод.Ссылка
		|  И Итоги.Участок = Прод.Ссылка.Участок
		|  И (Итоги.Расш1_НомерСтрокиЗаказа = Прод.НомерСтроки
		|   ИЛИ Итоги.Расш1_НомерСтрокиЗаказа = 0)
		|  И Итоги.Номенклатура = Прод.Номенклатура
		|  И Итоги.Характеристика = Прод.Характеристика
		|ГДЕ НЕ Прод.Ссылка.ПометкаУдаления
		| И Прод.Ссылка.Участок В (&Участки)
		| И (&ВсеЗаказы ИЛИ Прод.Ссылка = &Заказ)
		|СГРУППИРОВАТЬ ПО Прод.Ссылка, Прод.Ссылка.Номер, Прод.Ссылка.Дата,
		| Прод.Ссылка.Участок, Прод.НомерСтроки, Прод.Номенклатура,
		| Прод.Характеристика, Прод.Количество
		|УПОРЯДОЧИТЬ ПО ДатаЗаказа УБЫВ, Заказ, НомерСтрокиЗаказа");
	Запрос.УстановитьПараметр("Участки", Контекст.Участки);
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Запрос.УстановитьПараметр("ВсеЗаказы", Заказ.Пустая());
	Запрос.УстановитьПараметр("ИсключаемыйРегистратор", ИсключаемыйРегистратор);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Вызывается из ПередЗаписью документа, внутри транзакции записи.
// Повторное чтение под блокировкой защищает от двух одновременно открытых форм.
Процедура ПроверитьДокумент(Документ) Экспорт

	Контекст = ПроверитьДоступКЗаказу(Документ.Заказ, Документ.Участок);
	Если Документ.Работник <> Контекст.Работник Тогда
		ВызватьИсключение "Работник должен соответствовать текущему пользователю ИБ.";
	КонецЕсли;
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрНакопления.ВыработкаПоЗаказам");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Элемент.УстановитьЗначение("Заказ", Документ.Заказ);
	Элемент.УстановитьЗначение("Участок", Документ.Участок);
	Блокировка.Заблокировать();

	ИсходныеСтроки = СтрокиЗаказов(Документ.Заказ, Документ.Ссылка);
	НомераСтрок = Новый Соответствие;
	Для Каждого СтрокаПродукции Из Документ.Продукция Цикл
		Номер = СтрокаПродукции.Расш1_НомерСтрокиЗаказа;
		Если НомераСтрок.Получить(Номер) <> Неопределено Тогда
			ВызватьИсключение "Строка заказа повторяется в выработке.";
		КонецЕсли;
		НомераСтрок.Вставить(Номер, Истина);
		СтрокаЗаказа = ИсходныеСтроки.Найти(Номер, "НомерСтрокиЗаказа");
		Если СтрокаЗаказа = Неопределено Тогда
			ВызватьИсключение "Состав заказа изменён. Закройте форму и выберите заказ заново.";
		КонецЕсли;
		Если СтрокаЗаказа.Номенклатура <> СтрокаПродукции.Номенклатура
			ИЛИ СтрокаЗаказа.Характеристика <> СтрокаПродукции.Характеристика Тогда
			ВызватьИсключение "Изделие в строке заказа изменено. Откройте форму заново.";
		КонецЕсли;
		Если СтрокаПродукции.Выполнено < 0 ИЛИ СтрокаПродукции.Брак < 0
			ИЛИ СтрокаПродукции.Выполнено <> Цел(СтрокаПродукции.Выполнено)
			ИЛИ СтрокаПродукции.Брак <> Цел(СтрокаПродукции.Брак) Тогда
			ВызватьИсключение "Выполнено сейчас и брак должны быть целыми неотрицательными числами.";
		КонецЕсли;
		// Не доверяем плану и выполненному ранее, пришедшим из формы/API.
		СтрокаПродукции.План = СтрокаЗаказа.План;
		СтрокаПродукции.ВыполненоРанее = СтрокаЗаказа.Выполнено;
		СтрокаПродукции.Осталось = ОстатокСтроки(СтрокаЗаказа.План, СтрокаЗаказа.Выполнено,
			СтрокаПродукции.Выполнено, СтрокаПродукции.Брак);
		Если СтрокаПродукции.Осталось < 0 Тогда
			ВызватьИсключение "Выполнено и брак вместе не могут превышать остаток по заказу.";
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Старые движения с номером 0 учитываем только при однозначном соответствии
// изделию в заказе. Не меняем и не перепроводим исторические документы.
Процедура ПроверитьИсторическиеДвижения(Участки, Заказ, ИсключаемыйРегистратор)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1 Рег.Заказ КАК Заказ
		|ИЗ РегистрНакопления.ВыработкаПоЗаказам КАК Рег
		| ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказНаПроизводство.Продукция КАК Прод
		| ПО Прод.Ссылка = Рег.Заказ
		|  И Прод.Ссылка.Участок = Рег.Участок
		|  И Прод.Номенклатура = Рег.Номенклатура
		|  И Прод.Характеристика = Рег.Характеристика
		|ГДЕ Рег.Активность И Рег.Расш1_НомерСтрокиЗаказа = 0
		| И Рег.Участок В (&Участки)
		| И Рег.Регистратор <> &ИсключаемыйРегистратор
		| И (&ВсеЗаказы ИЛИ Рег.Заказ = &Заказ)
		|СГРУППИРОВАТЬ ПО Рег.Заказ, Рег.Участок, Рег.Номенклатура, Рег.Характеристика
		|ИМЕЮЩИЕ КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Прод.НомерСтроки) <> 1");
	Запрос.УстановитьПараметр("Участки", Участки);
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Запрос.УстановитьПараметр("ВсеЗаказы", Заказ.Пустая());
	Запрос.УстановитьПараметр("ИсключаемыйРегистратор", ИсключаемыйРегистратор);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ВызватьИсключение "Нельзя однозначно распределить историческую выработку по строкам заказа "
			+ Строка(Выборка.Заказ) + ". Требуется перенос исторических данных (см. README).";
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
