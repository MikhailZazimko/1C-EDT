#Область ПрограммныйИнтерфейс

// Печатаются сохранённые параметры выбранной редакции, без пересчёта по
// текущим правилам. Нормы и ручные корректировки утверждённого листа сохраняются.
Функция Сформировать(Ссылка) Экспорт
	Лист = Ссылка.ПолучитьОбъект();
	Если Лист = Неопределено ИЛИ Лист.ПометкаУдаления Тогда
		ВызватьИсключение "Технический лист не найден.";
	КонецЕсли;
	Если НЕ ПустаяСтрока(Лист.ОшибкиРасчета) Тогда
		ВызватьИсключение "Перед печатью устраните ошибки расчёта: " + Лист.ОшибкиРасчета;
	КонецЕсли;
	Документ = Новый ТабличныйДокумент;
	Документ.ИмяПараметровПечати = "Расш1_ТехническийЛистА4";
	Документ.РазмерСтраницы = "A4";
	Документ.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	Документ.ПолеСлева = 10;
	Документ.ПолеСправа = 10;
	Документ.ПолеСверху = 10;
	Документ.ПолеСнизу = 10;
	Документ.АвтоМасштаб = Истина;
	Документ.ОтображатьСетку = Ложь;
	Документ.ОтображатьЗаголовки = Ложь;
	Документ.Область(, 1, , 1).ШиринаКолонки = 34;
	Документ.Область(, 2, , 2).ШиринаКолонки = 68;
	Номер = 1;
	Раздел(Документ, Номер, "ТЕХНИЧЕСКИЙ ЛИСТ " + Лист.Код + " / редакция " + Строка(Лист.Редакция));
	Параметр(Документ, Номер, "Наименование", Лист.Наименование);
	Для Каждого Группа Из Расш1_СхемаТЛСервер.Разделы() Цикл
		Раздел(Документ, Номер, Группа.Заголовок);
		Для Каждого ИмяПоля Из СтрРазделить(Группа.Поля, ",") Цикл
			Значение = Лист[ИмяПоля];
			Если НЕ ЗначениеЗаполнено(Значение) И ТипЗнч(Значение) <> Тип("Булево") Тогда
				Продолжить;
			КонецЕсли;
			Подпись = Строка(Лист.Метаданные().Реквизиты.Найти(ИмяПоля).Синоним);
			Параметр(Документ, Номер, Подпись, ПредставлениеЗначения(Значение));
		КонецЦикла;
	КонецЦикла;
	Для Каждого ИмяТаблицы Из СтрРазделить("Операции,Отверстия,СлоиПечати,Коннекторы,Материалы,РучныеМатериалы,Файлы", ",") Цикл
		ПечататьТаблицу(Документ, Номер, Лист, ИмяТаблицы);
	КонецЦикла;
	Раздел(Документ, Номер, "Сводный состав материалов на базовый выпуск " + Строка(Лист.БазовоеКоличество));
	Для Каждого Материал Из Расш1_ТехническиеЛистыСервер.МатериалыТехЛиста(Ссылка) Цикл
		Параметр(Документ, Номер, Строка(Материал.Номенклатура) + " / " + Строка(Материал.Характеристика),
			Формат(Материал.Количество, "ЧГ=0;ЧДЦ=6"));
	КонецЦикла;
	Если Лист.Состояние = Перечисления.Расш1_СостоянияТЛ.Утвержден Тогда
		Раздел(Документ, Номер, "Состав УНФ: единицы и базовое количество продукции");
		Состав = Расш1_СпецификацииТЛСервер.СоставУНФ(Лист);
		Для Каждого СтрокаСостава Из Состав.Материалы Цикл
			Данные = СтрокаСостава.Данные;
			Параметр(Документ, Номер, Строка(Данные.Номенклатура) + " / " + Строка(Данные.Характеристика),
				Формат(Данные.Количество, "ЧГ=0") + " " + Строка(Данные.ЕдиницаИзмерения)
				+ " на " + Формат(Данные.КоличествоПродукции, "ЧГ=0") + " изделий");
		КонецЦикла;
	КонецЕсли;
	Документ.ТолькоПросмотр = Истина;
	Возврат Документ;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Шрифт задан для печатного листа А4 независимо от стиля интерфейса УНФ.
// BSLLS:StyleElementConstructors-off

Процедура Раздел(Документ, Номер, Заголовок)
	Область = Документ.Область(Номер, 1, Номер, 2);
	Область.Объединить();
	Область.Текст = Заголовок;
	Область.Шрифт = Новый Шрифт("Arial", 11, Истина);
	Область.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
	Область.АвтоВысотаСтроки = Истина;
	Номер = Номер + 1;
КонецПроцедуры

Процедура Параметр(Документ, Номер, Имя, Значение)
	Область = Документ.Область(Номер, 1, Номер, 2);
	Область.Шрифт = Новый Шрифт("Arial", 9);
	Область.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
	Область.АвтоВысотаСтроки = Истина;
	Документ.Область(Номер, 1).Текст = Имя;
	Документ.Область(Номер, 2).Текст = Значение;
	Номер = Номер + 1;
КонецПроцедуры

Функция ПредставлениеЗначения(Значение)
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат ?(Значение, "Да", "Нет");
	ИначеЕсли ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДФ=dd.MM.yyyy HH:mm");
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧГ=0");
	КонецЕсли;
	Возврат Строка(Значение);
КонецФункции

Процедура ПечататьТаблицу(Документ, Номер, Лист, ИмяТаблицы)
	Если Лист[ИмяТаблицы].Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ТаблицаМД = Лист.Метаданные().ТабличныеЧасти.Найти(ИмяТаблицы);
	Раздел(Документ, Номер, Строка(ТаблицаМД.Синоним));
	Скрытые = СтрРазделить("Идентификатор,КлючРасчета,ИдентификаторОперации,Данные,Автоматически", ",");
	Для Каждого СтрокаТаблицы Из Лист[ИмяТаблицы] Цикл
		Описание = Новый Массив;
		Для Каждого Поле Из ТаблицаМД.Реквизиты Цикл
			Если Скрытые.Найти(Поле.Имя) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Значение = СтрокаТаблицы[Поле.Имя];
			Если ЗначениеЗаполнено(Значение) ИЛИ ТипЗнч(Значение) = Тип("Булево") Тогда
				Описание.Добавить(Строка(Поле.Синоним) + ": " + ПредставлениеЗначения(Значение));
			КонецЕсли;
		КонецЦикла;
		Параметр(Документ, Номер, "Строка " + Строка(СтрокаТаблицы.НомерСтроки), СтрСоединить(Описание, "; "));
	КонецЦикла;
КонецПроцедуры

#КонецОбласти
