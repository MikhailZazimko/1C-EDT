#Область ПрограммныйИнтерфейс

// Чистый расчёт без запросов и записи объектов. Ссылки передаются как непрозрачные
// значения, а устойчивые ключи содержат UUID, не представления номенклатуры.
// Возвращаемое значение:
//  Структура - Материалы (Массив структур), Ошибки (Массив строк).
Функция Рассчитать(Параметры, Операции, Правила, Слои, Коннекторы, СтарыеМатериалы) Экспорт

	Результат = Новый Структура("Материалы,Ошибки", Новый Массив, Новый Массив);
	Корректировки = Новый Соответствие;
	Для Каждого Материал Из СтарыеМатериалы Цикл
		Если НЕ Материал.Автоматически Тогда
			Результат.Материалы.Добавить(Материал);
		Иначе
			Корректировки.Вставить(Материал.КлючРасчета, Материал.Корректировка);
		КонецЕсли;
	КонецЦикла;
	Если Параметры.БазовоеКоличество <= 0 Тогда
		Результат.Ошибки.Добавить("Базовое количество выпуска должно быть больше нуля.");
		Возврат Результат;
	КонецЕсли;
	Для Каждого Слой Из Слои Цикл
		Если Слой.Использовать И (Слой.Процент < 0 ИЛИ Слой.Процент > 100) Тогда
			Результат.Ошибки.Добавить("Процент нанесения слоя должен быть от 0 до 100.");
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;
	Ключи = Новый Соответствие;
	Для Каждого Операция Из Операции Цикл
		Если НЕ Операция.Использовать Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Правило Из Правила Цикл
			Если Правило.Операция <> Операция.Операция ИЛИ НЕ ПодходитУсловие(Правило, Параметры) Тогда
				Продолжить;
			КонецЕсли;
			Если НЕ ДопустимыйСпособ(Правило) Тогда
				Результат.Ошибки.Добавить("Способ расчёта не соответствует источнику материала: " + Правило.Наименование + ".");
				Продолжить;
			КонецЕсли;
			Источники = ИсточникиМатериала(Правило, Параметры, Слои, Коннекторы, Результат.Ошибки);
			Для Каждого Источник Из Источники Цикл
				ДобавитьРасчет(Результат, Ключи, Корректировки, Параметры, Операция,
					Правило, Источник, Слои, Коннекторы);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Объединяет ручной и автоматический расход по номенклатуре и характеристике.
// Разбивка по операциям остаётся в исходном массиве материалов.
Функция СводныйСостав(Материалы) Экспорт

	Итоги = Новый Соответствие;
	Результат = Новый Массив;
	Для Каждого Материал Из Материалы Цикл
		СтрокаИтога = Итоги.Получить(Материал.КлючМатериала);
		Если СтрокаИтога = Неопределено Тогда
			СтрокаИтога = Новый Структура("Номенклатура,Характеристика,Количество,КлючМатериала",
				Материал.Номенклатура, Материал.Характеристика, 0, Материал.КлючМатериала);
			Итоги.Вставить(Материал.КлючМатериала, СтрокаИтога);
			Результат.Добавить(СтрокаИтога);
		КонецЕсли;
		СтрокаИтога.Количество = СтрокаИтога.Количество + Материал.Количество;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПодходитУсловие(Правило, Параметры)

	Если Правило.ТолщинаОт > 0 И Параметры.Толщина < Правило.ТолщинаОт Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Правило.ТолщинаДо > 0 И Параметры.Толщина > Правило.ТолщинаДо Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ПустаяСтрока(Правило.Цвет) ИЛИ Правило.Цвет = Параметры.Цвет;

КонецФункции

Функция ДопустимыйСпособ(Правило)
	Если Правило.Источник = "Краска" Тогда
		Возврат Правило.Способ = "НаСлой" ИЛИ Правило.Способ = "НаПлощадьПечати";
	ИначеЕсли Правило.Источник = "Коннектор" Тогда
		Возврат Правило.Способ = "НаКоннектор";
	ИначеЕсли Правило.Источник = "Стекло" Тогда
		Возврат Правило.Способ = "НаИзделие" ИЛИ Правило.Способ = "НаПлощадьИзделия"
			ИЛИ Правило.Способ = "НаПлощадьЗаготовки";
	КонецЕсли;
	Возврат Правило.Источник = "Фиксированный";
КонецФункции

Функция НовыйИсточник(ИД, Материал, Характеристика, КлючМатериала, Количество, Процент = 100)

	Возврат Новый Структура("ИД,Номенклатура,Характеристика,КлючМатериала,Количество,Процент",
		ИД, Материал, Характеристика, КлючМатериала, Количество, Процент);

КонецФункции

Функция ПодходитСлой(Слой, Правило)

	Возврат Слой.Использовать И (ПустаяСтрока(Правило.ВидСлоя) ИЛИ Правило.ВидСлоя = Слой.ВидСлоя);

КонецФункции

Функция ИсточникиМатериала(Правило, Параметры, Слои, Коннекторы, Ошибки)

	Источники = Новый Массив;
	Если Правило.Источник = "Фиксированный" Тогда
		Источники.Добавить(НовыйИсточник("fixed", Правило.Номенклатура, Правило.Характеристика,
			Правило.КлючМатериала, 1));
	ИначеЕсли Правило.Источник = "Стекло" Тогда
		Источники.Добавить(НовыйИсточник("glass", Параметры.МатериалСтекла, Параметры.ХарактеристикаСтекла,
			Параметры.КлючСтекла, 1));
	ИначеЕсли Правило.Источник = "Краска" Тогда
		Для Каждого Слой Из Слои Цикл
			Если ПодходитСлой(Слой, Правило) Тогда
				Источники.Добавить(НовыйИсточник(Слой.ИД, Слой.Материал, Слой.Характеристика,
					Слой.КлючМатериала, 1, Слой.Процент));
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли Правило.Источник = "Коннектор" Тогда
		Для Каждого Коннектор Из Коннекторы Цикл
			Источники.Добавить(НовыйИсточник(Коннектор.ИД, Коннектор.Номенклатура, Коннектор.Характеристика,
				Коннектор.КлючМатериала, Коннектор.Количество));
		КонецЦикла;
	Иначе
		Ошибки.Добавить("Неизвестный источник материала правила " + Правило.Наименование + ".");
	КонецЕсли;
	Если Источники.Количество() = 0 Тогда
		Ошибки.Добавить("Нет исходных данных для материала правила " + Правило.Наименование + ".");
	КонецЕсли;
	Возврат Источники;

КонецФункции

Функция ПлощадьИзделия(Параметры)

	Если Параметры.ПлощадьИзделия > 0 Тогда
		Возврат Параметры.ПлощадьИзделия;
	КонецЕсли;
	Возврат Параметры.Ширина * Параметры.Высота / 1000000;

КонецФункции

Функция КоэффициентРасчета(Правило, Источник, Параметры, Слои, Коннекторы)

	Способ = Правило.Способ;
	Если Способ = "НаИзделие" Тогда
		Возврат 1;
	ИначеЕсли Способ = "НаПлощадьИзделия" Тогда
		Возврат ПлощадьИзделия(Параметры);
	ИначеЕсли Способ = "НаПлощадьЗаготовки" Тогда
		Если Параметры.ПлощадьЗаготовки > 0 Тогда
			Возврат Параметры.ПлощадьЗаготовки;
		КонецЕсли;
		Если Параметры.Ширина <= 0 ИЛИ Параметры.Высота <= 0 Тогда
			Возврат 0;
		КонецЕсли;
		Возврат (Параметры.Ширина + 2 * Параметры.Припуск) * (Параметры.Высота + 2 * Параметры.Припуск) / 1000000;
	ИначеЕсли Способ = "НаПериметр" Тогда
		Если Параметры.Периметр > 0 Тогда
			Возврат Параметры.Периметр;
		КонецЕсли;
		Если Параметры.Ширина <= 0 ИЛИ Параметры.Высота <= 0 Тогда
			Возврат 0;
		КонецЕсли;
		Возврат 2 * (Параметры.Ширина + Параметры.Высота) / 1000;
	ИначеЕсли Способ = "НаОтверстие" Тогда
		Возврат Параметры.Отверстий;
	ИначеЕсли Способ = "НаКоннектор" Тогда
		Если Правило.Источник = "Коннектор" Тогда
			Возврат Источник.Количество;
		КонецЕсли;
		Количество = 0;
		Для Каждого Коннектор Из Коннекторы Цикл
			Количество = Количество + Коннектор.Количество;
		КонецЦикла;
		Возврат Количество;
	ИначеЕсли Способ = "НаСлой" ИЛИ Способ = "НаПлощадьПечати" Тогда
		Возврат КоэффициентПечати(Правило, Источник, Параметры, Слои);
	КонецЕсли;
	Возврат -1;

КонецФункции

Функция КоэффициентПечати(Правило, Источник, Параметры, Слои)

	Если Правило.Источник = "Краска" Тогда
		Если Правило.Способ = "НаСлой" Тогда
			Возврат 1;
		КонецЕсли;
		Возврат ПлощадьИзделия(Параметры) * Источник.Процент / 100;
	КонецЕсли;
	Коэффициент = 0;
	Для Каждого Слой Из Слои Цикл
		Если НЕ ПодходитСлой(Слой, Правило) Тогда
			Продолжить;
		КонецЕсли;
		Если Правило.Способ = "НаСлой" Тогда
			Коэффициент = Коэффициент + 1;
		Иначе
			Коэффициент = Коэффициент + ПлощадьИзделия(Параметры) * Слой.Процент / 100;
		КонецЕсли;
	КонецЦикла;
	Возврат Коэффициент;

КонецФункции

Процедура ДобавитьРасчет(Результат, Ключи, Корректировки, Параметры, Операция, Правило, Источник, Слои, Коннекторы)

	Если ПустаяСтрока(Источник.КлючМатериала) Тогда
		Результат.Ошибки.Добавить("Не выбран материал для правила " + Правило.Наименование + ".");
		Возврат;
	КонецЕсли;
	Коэффициент = КоэффициентРасчета(Правило, Источник, Параметры, Слои, Коннекторы);
	Если Коэффициент <= 0 ИЛИ Правило.Норма <= 0 ИЛИ Правило.Потери < 0 Тогда
		Результат.Ошибки.Добавить("Недостаточно данных или неверная норма для правила " + Правило.Наименование + ".");
		Возврат;
	КонецЕсли;
	Ключ = Операция.ИД + "|" + Правило.ИД + "|" + Источник.ИД + "|" + Источник.КлючМатериала;
	Если Ключи.Получить(Ключ) <> Неопределено Тогда
		Результат.Ошибки.Добавить("Повторяется идентификатор операции или исходной строки: " + Операция.ИД + ".");
		Возврат;
	КонецЕсли;
	Ключи.Вставить(Ключ, Истина);
	Норма = Окр(Правило.Норма * Коэффициент * Параметры.БазовоеКоличество * (1 + Правило.Потери / 100), 6);
	Если Норма = 0 Тогда
		Результат.Ошибки.Добавить("Норма меньше точности техлиста. Увеличьте базовое количество выпуска для правила " + Правило.Наименование + ".");
		Возврат;
	КонецЕсли;
	Корректировка = Корректировки.Получить(Ключ);
	Если Корректировка = Неопределено Тогда
		Корректировка = 0;
	КонецЕсли;
	Если Норма + Корректировка < 0 Тогда
		Результат.Ошибки.Добавить("Ручная корректировка делает норму отрицательной для правила " + Правило.Наименование + ".");
		Возврат;
	КонецЕсли;
	Материал = Новый Структура;
	Материал.Вставить("Номенклатура", Источник.Номенклатура);
	Материал.Вставить("Характеристика", Источник.Характеристика);
	Материал.Вставить("КлючМатериала", Источник.КлючМатериала);
	Материал.Вставить("Количество", Норма + Корректировка);
	Материал.Вставить("Рассчитано", Норма);
	Материал.Вставить("Корректировка", Корректировка);
	Материал.Вставить("Автоматически", Истина);
	Материал.Вставить("Операция", Операция.Операция);
	Материал.Вставить("ИдентификаторОперации", Операция.ИД);
	Материал.Вставить("Правило", Правило.Ссылка);
	Материал.Вставить("КлючРасчета", Ключ);
	Материал.Вставить("ОснованиеРасчета", Правило.Способ + ": норма " + Строка(Правило.Норма)
		+ " × " + Строка(Коэффициент) + " × выпуск " + Строка(Параметры.БазовоеКоличество)
		+ "; дополнительный расход " + Строка(Правило.Потери) + " %");
	Результат.Материалы.Добавить(Материал);

КонецПроцедуры

#КонецОбласти
