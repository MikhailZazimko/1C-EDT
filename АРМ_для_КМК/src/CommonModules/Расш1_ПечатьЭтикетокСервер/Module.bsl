#Область ПрограммныйИнтерфейс

// Печать не записывает документ выработки. Единственное изменение данных -
// резервирование диапазона номеров этикеток, общего для всей информационной базы.
// Отменённая печать и ошибки формирования оставляют допустимые пропуски номеров.
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказНаПроизводство - заказ текущего рабочего места.
//  Участок - СправочникСсылка.Участки - участок заказа.
//  НомерСтрокиЗаказа - Число - номер строки продукции в заказе.
//  Количество - Число - целое число этикеток от 1 до 1000.
//
// Возвращаемое значение:
//  ТабличныйДокумент - этикетки, по одной на странице 58 x 40 мм.
Функция СформироватьЭтикетки(Заказ, Участок, НомерСтрокиЗаказа, Количество) Экспорт

	Если ТипЗнч(Количество) <> Тип("Число") Тогда
		ВызватьИсключение "Укажите целое количество этикеток от 1 до 1000.";
	КонецЕсли;
	Если Количество < 1 ИЛИ Количество > 1000 ИЛИ Количество <> Цел(Количество) Тогда
		ВызватьИсключение "Укажите целое количество этикеток от 1 до 1000.";
	КонецЕсли;
	Если ТипЗнч(НомерСтрокиЗаказа) <> Тип("Число") Тогда
		ВызватьИсключение "Выберите изделие в таблице продукции.";
	КонецЕсли;
	Если НомерСтрокиЗаказа < 1 ИЛИ НомерСтрокиЗаказа <> Цел(НомерСтрокиЗаказа) Тогда
		ВызватьИсключение "Выберите изделие в таблице продукции.";
	КонецЕсли;

	Контекст = Расш1_ВыработкаСервер.ПроверитьДоступКЗаказу(Заказ, Участок);
	// Название и характеристику перечитываем из заказа; текст клиента не печатаем.
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		| Продукция.Номенклатура КАК Номенклатура,
		| Продукция.Характеристика КАК Характеристика
		|ИЗ Документ.ЗаказНаПроизводство.Продукция КАК Продукция
		|ГДЕ Продукция.Ссылка = &Заказ
		| И Продукция.НомерСтроки = &НомерСтроки");
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Запрос.УстановитьПараметр("НомерСтроки", НомерСтрокиЗаказа);
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		ВызватьИсключение "Строка изделия не найдена в заказе. Откройте заказ из журнала заново.";
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Выборка.Номенклатура) Тогда
		ВызватьИсключение "В выбранной строке заказа не заполнена номенклатура.";
	КонецЕсли;

	Изделие = Строка(Выборка.Номенклатура);
	Если ЗначениеЗаполнено(Выборка.Характеристика) Тогда
		Изделие = Изделие + " / " + Строка(Выборка.Характеристика);
	КонецЕсли;
	Работник = Строка(Контекст.Работник);
	Если НЕ ЗначениеЗаполнено(Контекст.Работник) Тогда
		Работник = Контекст.ИмяПользователяИБ;
	КонецЕсли;

	Макет = ПолучитьОбщийМакет("Расш1_Этикетка58х40");
	Этикетка = Макет.ПолучитьОбласть("Этикетка");
	// Высоты в пунктах задаём через интерфейс табличного документа.
	Этикетка.Область(1, 1, 1, 2).ВысотаСтроки = 14;
	Этикетка.Область(2, 1, 2, 2).ВысотаСтроки = 4;
	Этикетка.Область(3, 1, 3, 2).ВысотаСтроки = 36;
	Этикетка.Область(4, 1, 4, 2).ВысотаСтроки = 13;
	Этикетка.Область(5, 1, 5, 2).ВысотаСтроки = 29;
	Этикетка.Параметры.Работник = Работник;
	Этикетка.Параметры.ДатаПечати = Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy HH:mm");
	Этикетка.Параметры.Изделие = Изделие;

	// Штатный серверный интерфейс БСП, используемой основной конфигурацией УНФ.
	ПараметрыШтрихкода = ГенерацияШтрихкода.ПараметрыГенерацииШтрихкода();
	ПараметрыШтрихкода.ТипКода = 4; // Code128, поддерживает числовые коды любой длины.
	ПараметрыШтрихкода.Ширина = 432;
	ПараметрыШтрихкода.Высота = 100;
	ПараметрыШтрихкода.ОтображатьТекст = Ложь;
	ПараметрыШтрихкода.ПрозрачныйФон = Ложь;

	ТабличныйДокумент = Новый ТабличныйДокумент;
	НастроитьСтраницу(ТабличныйДокумент);
	ПервыйНомер = ЗарезервироватьНомера(Количество);
	Для Индекс = 0 По Количество - 1 Цикл
		КодЭтикетки = КодИзНомера(ПервыйНомер + Индекс);
		ПараметрыШтрихкода.Штрихкод = КодЭтикетки;
		Изображение = ГенерацияШтрихкода.ИзображениеШтрихкода(ПараметрыШтрихкода);
		Если НЕ Изображение.Результат ИЛИ Изображение.Картинка = Неопределено Тогда
			ВызватьИсключение "Не удалось сформировать штрихкод этикетки " + КодЭтикетки + ".";
		КонецЕсли;
		Этикетка.Параметры.КодЭтикетки = КодЭтикетки;
		Этикетка.Рисунки.Штрихкод.Картинка = Изображение.Картинка;
		Если Индекс > 0 Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ТабличныйДокумент.Вывести(Этикетка);
	КонецЦикла;
	Возврат ТабличныйДокумент;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗарезервироватьНомера(Количество)

	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("РегистрСведений.Расш1_НумерацияЭтикеток");
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		Элемент.УстановитьЗначение("Серия", "КМК");
		Блокировка.Заблокировать();
		Запись = РегистрыСведений.Расш1_НумерацияЭтикеток.СоздатьМенеджерЗаписи();
		Запись.Серия = "КМК";
		Запись.Прочитать();
		ПоследнийНомер = Запись.ПоследнийНомер;
		Если ПоследнийНомер + Количество > 999999999999 Тогда
			ВызватьИсключение "Исчерпан диапазон номеров этикеток.";
		КонецЕсли;
		Запись.Серия = "КМК";
		Запись.ПоследнийНомер = ПоследнийНомер + Количество;
		Запись.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат ПоследнийНомер + 1;

КонецФункции

Функция КодИзНомера(Номер)

	ТекстНомера = Формат(Номер, "ЧГ=0;ЧДЦ=0");
	Возврат Лев("000000000000", 12 - СтрДлина(ТекстНомера)) + ТекстНомера;

КонецФункции

Процедура НастроитьСтраницу(ТабличныйДокумент)

	ТабличныйДокумент.ИмяПараметровПечати = "Расш1_Этикетка58х40";
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.РазмерСтраницы = "Custom";
	ТабличныйДокумент.ШиринаСтраницы = 58;
	ТабличныйДокумент.ВысотаСтраницы = 40;
	ТабличныйДокумент.ПолеСлева = 2;
	ТабличныйДокумент.ПолеСправа = 2;
	ТабличныйДокумент.ПолеСверху = 2;
	ТабличныйДокумент.ПолеСнизу = 2;
	ТабличныйДокумент.РазмерКолонтитулаСверху = 0;
	ТабличныйДокумент.РазмерКолонтитулаСнизу = 0;
	ТабличныйДокумент.КоличествоЭкземпляров = 1;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОтображатьСетку = Ложь;
	ТабличныйДокумент.ОтображатьЗаголовки = Ложь;
	ТабличныйДокумент.ТолькоПросмотр = Истина;

КонецПроцедуры

#КонецОбласти
