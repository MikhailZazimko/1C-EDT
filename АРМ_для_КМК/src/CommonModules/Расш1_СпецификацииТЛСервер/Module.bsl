#Область ПрограммныйИнтерфейс

// Подписка на запись, выполняемая внутри транзакции типовой спецификации.
// Связанный черновик и его счётчик записываются в той же транзакции; отказ
// типовой записи откатывает и изменения техлиста.
// BSLLS:DataExchangeLoading-off
Процедура СпецификацияПередЗаписью(Источник, Отказ) Экспорт
	Если Отказ ИЛИ Источник.ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;
	Если НЕ Источник.Расш1_ЭтоТехническийЛист И НЕ ЕстьАвтоматическиеСтроки(Источник) Тогда
		Возврат;
	КонецЕсли;
	Расш1_ТехническиеЛистыСервер.ПроверитьПравоРедактирования();
	Если НЕ Источник.Расш1_ЭтоТехническийЛист Тогда
		Синхронизировать(Источник, Неопределено);
		Возврат;
	КонецЕсли;
	ТребуетсяЗапись = Истина;
	Лист = ЛистДляЗаписи(Источник, ТребуетсяЗапись);
	ПроверитьИзделие(Источник, Лист);
	Если ТребуетсяЗапись Тогда
		Если НЕ ТранзакцияАктивна() Тогда
			ВызватьИсключение "Связанный технический лист необходимо сохранять в транзакции записи спецификации.";
		КонецЕсли;
		Лист.Записать();
	КонецЕсли;
	Источник.Расш1_ТехническийЛист = Лист.Ссылка;
	Если Лист.Индивидуальный Тогда
		Если ЗначениеЗаполнено(Источник.Заказ) И Источник.Заказ <> Лист.Заказ Тогда
			ВызватьИсключение "Индивидуальный техлист относится к другому заказу.";
		КонецЕсли;
		Источник.Заказ = Лист.Заказ;
	КонецЕсли;
	Синхронизировать(Источник, Лист);
КонецПроцедуры
// BSLLS:DataExchangeLoading-on

// Работает с объектом каталога и с данными управляемой формы. Меняет только
// помеченные собственные строки; сохраняет ручные строки и их дополнительные
// колонки формы. Все проверки плана выполнены до изменения коллекций.
Процедура Синхронизировать(Спецификация, Лист) Экспорт
	Расш1_ТехническиеЛистыСервер.ПроверитьПравоРедактирования();
	Материалы = Новый Массив;
	Операции = Новый Массив;
	Если Лист <> Неопределено Тогда
		ПроверитьИзделие(Спецификация, Лист);
		Состав = СоставУНФ(Лист);
		Материалы = Состав.Материалы;
		Операции = Состав.Операции;
	КонецЕсли;
	ПланСостава = Расш1_СоставТЛРасчет.ПланСинхронизации(СуществующиеСтроки(Спецификация.Состав, Ложь), Материалы);
	ПланОпераций = Расш1_СоставТЛРасчет.ПланСинхронизации(СуществующиеСтроки(Спецификация.Операции, Истина), Операции);
	Ошибки = Новый Массив;
	Для Каждого Ошибка Из ПланСостава.Ошибки Цикл
		Ошибки.Добавить(Ошибка);
	КонецЦикла;
	Для Каждого Ошибка Из ПланОпераций.Ошибки Цикл
		Ошибки.Добавить(Ошибка);
	КонецЦикла;
	Если Ошибки.Количество() > 0 Тогда
		ВызватьИсключение СтрСоединить(Ошибки, Символы.ПС);
	КонецЕсли;
	ПрименитьПлан(Спецификация.Состав, ПланСостава, Ложь);
	ПрименитьПлан(Спецификация.Операции, ПланОпераций, Истина);
КонецПроцедуры

// При утверждении фиксируются не только нормы, но и реальные единицы,
// работы и точные базы выпуска. Последующие изменения справочников
// не меняют перенос уже утверждённой технологии в УНФ.
Процедура ЗафиксироватьСоставУНФ(Лист) Экспорт
	Расш1_ТехническиеЛистыСервер.ПроверитьПравоРедактирования();
	Лист.СнимокСоставаУНФ = Новый ХранилищеЗначения(
		Новый Структура("Материалы,Операции", МатериалыУНФ(Лист), ОперацииУНФ(Лист)));
КонецПроцедуры

Функция СоставУНФ(Лист) Экспорт
	Если НЕ ПустаяСтрока(Лист.ОшибкиРасчета) Тогда
		ВызватьИсключение "Завершите расчёт материалов техлиста: " + Лист.ОшибкиРасчета;
	КонецЕсли;
	Если Лист.Состояние = Перечисления.Расш1_СостоянияТЛ.Утвержден Тогда
		Если Лист.СнимокСоставаУНФ = Неопределено Тогда
			ВызватьИсключение "У утверждённого техлиста отсутствует зафиксированный состав УНФ.";
		КонецЕсли;
		Возврат Лист.СнимокСоставаУНФ.Получить();
	КонецЕсли;
	Возврат Новый Структура("Материалы,Операции", МатериалыУНФ(Лист), ОперацииУНФ(Лист));
КонецФункции

Процедура ПроверитьИзделие(Спецификация, Лист) Экспорт
	Если ЗначениеЗаполнено(Лист.Номенклатура) И Лист.Номенклатура <> Спецификация.Владелец Тогда
		ВызватьИсключение "Изделие технического листа не соответствует продукции спецификации.";
	КонецЕсли;
	Если Лист.Характеристика <> Спецификация.ХарактеристикаПродукции Тогда
		ВызватьИсключение "Характеристика технического листа не соответствует спецификации.";
	КонецЕсли;
	Если Лист.Индивидуальный И ЗначениеЗаполнено(Спецификация.Заказ) И Спецификация.Заказ <> Лист.Заказ Тогда
		ВызватьИсключение "Индивидуальный техлист относится к другому заказу.";
	КонецЕсли;
КонецПроцедуры

Функция НовыйЛистСпецификации(Спецификация) Экспорт
	Расш1_ТехническиеЛистыСервер.ПроверитьПравоРедактирования();
	Лист = Справочники.Расш1_ТехническиеЛисты.СоздатьЭлемент();
	Расш1_ТехническиеЛистыСервер.ПодготовитьНовый(Лист);
	Лист.Номенклатура = Спецификация.Владелец;
	Лист.Характеристика = Спецификация.ХарактеристикаПродукции;
	Лист.Наименование = Спецификация.Наименование;
	Возврат Лист;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЛистДляЗаписи(Спецификация, ТребуетсяЗапись)
	Перем ЛистФормы, ПрочитанноеСостояние;
	ЕстьДанныеФормы = Спецификация.ДополнительныеСвойства.Свойство("Расш1_ДанныеТЛ", ЛистФормы);
	Если ЗначениеЗаполнено(Спецификация.Расш1_ТехническийЛист) Тогда
		Сохраненный = Спецификация.Расш1_ТехническийЛист.ПолучитьОбъект();
		Если Сохраненный = Неопределено ИЛИ Сохраненный.ПометкаУдаления Тогда
			ВызватьИсключение "Связанный технический лист удалён или не существует.";
		КонецЕсли;
		Если Сохраненный.Состояние = Перечисления.Расш1_СостоянияТЛ.Утвержден Тогда
			Если Спецификация.ДополнительныеСвойства.Свойство("Расш1_ПрочитанноеСостояниеТЛ", ПрочитанноеСостояние)
				И ПрочитанноеСостояние <> Перечисления.Расш1_СостоянияТЛ.Утвержден Тогда
				ВызватьИсключение "Техлист уже утверждён в другом сеансе. Перечитайте спецификацию.";
			КонецЕсли;
			// Параметры из клиента не заменяют утверждённые данные базы.
			ТребуетсяЗапись = Ложь;
			Возврат Сохраненный;
		КонецЕсли;
	КонецЕсли;
	Если ЕстьДанныеФормы Тогда
		Если ТипЗнч(ЛистФормы) <> Тип("СправочникОбъект.Расш1_ТехническиеЛисты") Тогда
			ВызватьИсключение "Переданы неподходящие данные технического листа.";
		КонецЕсли;
		Если ЗначениеЗаполнено(Спецификация.Расш1_ТехническийЛист)
			И ЛистФормы.Ссылка <> Спецификация.Расш1_ТехническийЛист Тогда
			ВызватьИсключение "На вкладке открыта другая редакция техлиста. Перечитайте спецификацию.";
		КонецЕсли;
		Возврат ЛистФормы;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Спецификация.Расш1_ТехническийЛист) Тогда
		ВызватьИсключение "Для спецификации с флажком «Технический лист» заполните вкладку техлиста.";
	КонецЕсли;
	Возврат Сохраненный;
КонецФункции

Функция ЕстьАвтоматическиеСтроки(Спецификация)
	Для Каждого СтрокаТаблицы Из Спецификация.Состав Цикл
		Если СтрокаТаблицы.Расш1_ИзТехЛиста Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Для Каждого СтрокаТаблицы Из Спецификация.Операции Цикл
		Если СтрокаТаблицы.Расш1_ИзТехЛиста Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция КлючСсылки(Ссылка)
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат "";
	КонецЕсли;
	Возврат Строка(Ссылка.УникальныйИдентификатор());
КонецФункции

Функция МатериалыУНФ(Лист)
	Результат = Новый Массив;
	Исходные = Новый Массив;
	Для Каждого СтрокаМатериала Из Лист.Материалы Цикл
		Исходные.Добавить(ДанныеМатериала(СтрокаМатериала));
	КонецЦикла;
	Для Каждого СтрокаМатериала Из Лист.РучныеМатериалы Цикл
		Исходные.Добавить(ДанныеМатериала(СтрокаМатериала));
	КонецЦикла;
	Для Каждого Материал Из Расш1_МатериалыТЛРасчет.СводныйСостав(Исходные) Цикл
		Если Материал.Количество = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Материал.Номенклатура) Тогда
			Продолжить; // Незавершённая ручная строка черновика не переносится.
		КонецЕсли;
		Норма = Расш1_СоставТЛРасчет.НормаДляУНФ(Материал.Количество, Лист.БазовоеКоличество);
		Данные = Новый Структура("Номенклатура,Характеристика,Количество,КоличествоПродукции,ЕдиницаИзмерения,ТипСтрокиСостава",
			Материал.Номенклатура, Материал.Характеристика, Норма.Количество, Норма.КоличествоПродукции,
			БазоваяЕдиницаМатериала(Материал.Номенклатура), ТипСтрокиМатериала());
		Результат.Добавить(Новый Структура("Ключ,Данные", Материал.КлючМатериала, Данные));
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ДанныеМатериала(СтрокаМатериала)
	Возврат Новый Структура("Номенклатура,Характеристика,Количество,КлючМатериала",
		СтрокаМатериала.Номенклатура, СтрокаМатериала.Характеристика, СтрокаМатериала.Количество,
		КлючСсылки(СтрокаМатериала.Номенклатура) + "/" + КлючСсылки(СтрокаМатериала.Характеристика));
КонецФункции

Функция ОперацииУНФ(Лист)
	Результат = Новый Массив;
	Для Каждого Операция Из Лист.Операции Цикл
		Если НЕ Операция.Использовать Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Операция.РаботаУНФ) Тогда
			Если Лист.Состояние = Перечисления.Расш1_СостоянияТЛ.Утвержден Тогда
				ВызватьИсключение "Для утверждения у каждой операции техлиста выберите работу УНФ.";
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		// Вид «Операция» подтверждён параметрами выбора типовой формы УНФ.
		Если Операция.РаботаУНФ.ТипНоменклатуры <> Перечисления.ТипыНоменклатуры.Операция Тогда
			ВызватьИсключение "Для операции УНФ выберите номенклатуру с типом «Операция».";
		КонецЕсли;
		// Минуты на одно изделие = часы на 60 изделий. При необходимости
		// увеличиваем базу партии, сохраняя точность нормы времени (3 знака).
		Норма = Расш1_СоставТЛРасчет.НормаОперацииДляУНФ(Операция.НормаВремениМин);
		Данные = Новый Структура("Операция,Количество,КоличествоПродукции,НормаВремени",
			Операция.РаботаУНФ, Норма.Количество, Норма.КоличествоПродукции, Норма.НормаВремени);
		Результат.Добавить(Новый Структура("Ключ,Данные", Операция.Идентификатор, Данные));
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция БазоваяЕдиницаМатериала(Номенклатура)
	// Поле проверяется в реальной метамодели, поэтому несовместимая версия
	// не получает вымышленную единицу «штуки» для всех видов материалов.
	Если Номенклатура.Метаданные().Реквизиты.Найти("ЕдиницаИзмерения") = Неопределено Тогда
		ВызватьИсключение "Не найден реквизит базовой единицы номенклатуры. Нужны метаданные справочника «Номенклатура».";
	КонецЕсли;
	Единица = Номенклатура.ПолучитьОбъект().ЕдиницаИзмерения;
	Если НЕ ЗначениеЗаполнено(Единица) Тогда
		ВызватьИсключение "У материала «" + Строка(Номенклатура) + "» не заполнена базовая единица.";
	КонецЕсли;
	Возврат Единица;
КонецФункции

Функция ТипСтрокиМатериала()
	Возврат Перечисления.ТипыСтрокСоставаСпецификации.Материал;
КонецФункции

Функция СнимокСтроки(СтрокаТаблицы, Операция)
	Если Операция Тогда
		Снимок = Новый Структура("Операция,Количество,Продукция,Время", КлючСсылки(СтрокаТаблицы.Операция),
			СтрокаТаблицы.Количество, СтрокаТаблицы.КоличествоПродукции, СтрокаТаблицы.НормаВремени);
	Иначе
		Снимок = Новый Структура("Номенклатура,Характеристика,Количество,Продукция,Единица,ТипСтроки",
			КлючСсылки(СтрокаТаблицы.Номенклатура), КлючСсылки(СтрокаТаблицы.Характеристика),
			СтрокаТаблицы.Количество, СтрокаТаблицы.КоличествоПродукции,
			КлючСсылки(СтрокаТаблицы.ЕдиницаИзмерения), ЗначениеВСтрокуВнутр(СтрокаТаблицы.ТипСтрокиСостава));
	КонецЕсли;
	Возврат ЗначениеВСтрокуВнутр(Снимок);
КонецФункции

Функция СуществующиеСтроки(Таблица, Операция)
	Результат = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Если СтрокаТаблицы.Расш1_ИзТехЛиста Тогда
			Если Операция И (СтрокаТаблицы.ИспользуетсяСопоставление
				ИЛИ ЗначениеЗаполнено(СтрокаТаблицы.ФормулаОперация)
				ИЛИ ЗначениеЗаполнено(СтрокаТаблицы.ФормулаНормаВремени)) Тогда
				ВызватьИсключение "Формулы и сопоставления задавайте в отдельных ручных строках операций.";
			КонецЕсли;
			Если НЕ Операция И (СтрокаТаблицы.ИспользуетсяСопоставление
				ИЛИ ЗначениеЗаполнено(СтрокаТаблицы.ФормулаНоменклатура)
				ИЛИ ЗначениеЗаполнено(СтрокаТаблицы.ФормулаКоличество)
				ИЛИ ЗначениеЗаполнено(СтрокаТаблицы.ФормулаХарактеристика)) Тогда
				ВызватьИсключение "Формулы и сопоставления задавайте в отдельных ручных строках состава.";
			КонецЕсли;
			Результат.Добавить(Новый Структура("Ключ,Автоматически,ТекущийСнимок,СохраненныйСнимок,Строка",
				СтрокаТаблицы.Расш1_КлючТехЛиста, Истина, СнимокСтроки(СтрокаТаблицы, Операция),
				СтрокаТаблицы.Расш1_СнимокТехЛиста, СтрокаТаблицы));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура ПрименитьПлан(Таблица, План, Операция)
	Для Каждого СтрокаТаблицы Из План.Удалить Цикл
		Таблица.Удалить(СтрокаТаблицы);
	КонецЦикла;
	Для Каждого Изменение Из План.Обновить Цикл
		ЗаполнитьАвтоСтроку(Изменение.Строка, Изменение.План, Операция);
	КонецЦикла;
	КлючСвязи = 0;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		КлючСвязи = Макс(КлючСвязи, СтрокаТаблицы.КлючСвязи);
	КонецЦикла;
	Для Каждого НоваяСтрока Из План.Добавить Цикл
		КлючСвязи = КлючСвязи + 1;
		Если КлючСвязи > 99999 Тогда
			ВызватьИсключение "Исчерпан диапазон ключей связи строк спецификации.";
		КонецЕсли;
		СтрокаТаблицы = Таблица.Добавить();
		СтрокаТаблицы.КлючСвязи = КлючСвязи;
		ЗаполнитьАвтоСтроку(СтрокаТаблицы, НоваяСтрока, Операция);
	КонецЦикла;
КонецПроцедуры

Процедура ЗаполнитьАвтоСтроку(СтрокаТаблицы, План, Операция)
	ЗаполнитьЗначенияСвойств(СтрокаТаблицы, План.Данные);
	СтрокаТаблицы.Расш1_ИзТехЛиста = Истина;
	СтрокаТаблицы.Расш1_КлючТехЛиста = План.Ключ;
	СтрокаТаблицы.Расш1_СнимокТехЛиста = СнимокСтроки(СтрокаТаблицы, Операция);
КонецПроцедуры

#КонецОбласти
