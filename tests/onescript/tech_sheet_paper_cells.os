Перем Проверок;
Перем МодульЯчеек;

Процедура Равно(Факт, Ожидание, Сценарий)
	Если Факт <> Ожидание Тогда
		ВызватьИсключение Сценарий + ": ожидалось " + Строка(Ожидание) + ", получено " + Строка(Факт);
	КонецЕсли;
	Проверок = Проверок + 1;
КонецПроцедуры

Функция Таблица(Список)
	Т = Новый ТаблицаЗначений;
	Для Каждого Имя Из СтрРазделить(Список, ",") Цикл
		Т.Колонки.Добавить(Имя);
	КонецЦикла;
	Возврат Т;
КонецФункции

Функция МассивИз(А = "", Б = "", В = "")
	Р = Новый Массив; Р.Добавить(А); Р.Добавить(Б); Р.Добавить(В);
	Возврат Р;
КонецФункции

Проверок = 0;
МодульЯчеек = ЗагрузитьСценарий(АргументыКоманднойСтроки[0]);
Слои = Таблица("Идентификатор,Использовать,ПроцентНанесения,Примечание");
ИД = МодульЯчеек.ИзменитьЯчейку(Слои, "СлоиПечати", "", "Примечание", "Лицевая сторона");
Равно(Слои.Количество(), 1, "Ввод в свободную колонку создаёт одну строку");
Равно(Слои[0].Идентификатор, ИД, "Строка имеет устойчивый идентификатор");
Равно(Слои[0].Использовать, Истина, "Новый слой включён");
Равно(Слои[0].ПроцентНанесения, 100, "По умолчанию площадь нанесения 100 процентов");
Равно(МодульЯчеек.ИзменитьЯчейку(Слои, "СлоиПечати", ИД, "ПроцентНанесения", 25), ИД,
	"Повторное изменение сохраняет идентификатор");
Равно(Слои.Количество(), 1, "Повторное изменение не создаёт дубликат");
Равно(Слои[0].Примечание, "Лицевая сторона", "Соседняя ячейка сохранена");
МодульЯчеек.ИзменитьЯчейку(Слои, "СлоиПечати", ИД, "Использовать", Ложь);
МодульЯчеек.ИзменитьЯчейку(Слои, "СлоиПечати", ИД, "Примечание", "Отключён");
Равно(Слои[0].Использовать, Ложь, "Правка примечания не включает отключённый слой");
МодульЯчеек.ИзменитьЯчейку(Слои, "СлоиПечати", ИД, "ПроцентНанесения", 0);
Равно(Слои[0].ПроцентНанесения, 0, "Явный ноль не подменяется значением по умолчанию");
ИД2 = МодульЯчеек.ИзменитьЯчейку(Слои, "СлоиПечати", "", "Примечание", "Вторая запись");
Привязки = МодульЯчеек.ПривязкиКолонок(Слои, МассивИз("", "", ИД), 3);
Равно(Привязки[2], ИД, "Редактирование третьей колонки не перемещает её в первую");
Равно(Привязки[0], ИД2, "Свободная колонка показывает другую строку");
Равно(Привязки[1], "", "Пустая колонка не создаёт фиктивную строку");
Для Индекс = 3 По 5 Цикл
	МодульЯчеек.ИзменитьЯчейку(Слои, "СлоиПечати", "", "Примечание", "Слой " + Строка(Индекс));
КонецЦикла;
Привязки = МодульЯчеек.ПривязкиКолонок(Слои, Новый Массив, 3);
Равно(Привязки.Количество(), 3, "Основной лист показывает три колонки");
Равно(Слои.Количество(), 5, "Дополнительные слои сохранены в полной таблице");
Слои.Сдвинуть(0, 4);
Привязки = МодульЯчеек.ПривязкиКолонок(Слои, Привязки, 3);
Равно(Привязки[0], ИД, "Перестановка строк не меняет активную привязку");
МодульЯчеек.ИзменитьЯчейку(Слои, "СлоиПечати", ИД, "Примечание", "Изменена исходная строка");
Равно(Слои[4].Примечание, "Изменена исходная строка", "Меняется строка по идентификатору");
Ошибка = Ложь;
Попытка
	МодульЯчеек.ИзменитьЯчейку(Слои, "СлоиПечати", "удалённая-строка", "Примечание", "");
Исключение
	Ошибка = Истина;
КонецПопытки;
Равно(Ошибка, Истина, "Устаревшая привязка отклоняется");
Равно(Слои.Количество(), 5, "Устаревшая привязка не дублирует строку");
Коннекторы = Таблица("Идентификатор,Количество,КоличествоПаек,Примечание");
МодульЯчеек.ИзменитьЯчейку(Коннекторы, "Коннекторы", "", "Примечание", "Контакт");
Равно(Коннекторы[0].Количество, 1, "Новый коннектор имеет количество 1");
Равно(Коннекторы[0].КоличествоПаек, 1, "Новый коннектор имеет одну пайку");
Равно(Коннекторы.Количество(), 1, "Ввод коннектора не создаёт промежуточных строк");
Сообщить("OK: " + Строка(Проверок) + " проверок ячеек бумажного представления");
