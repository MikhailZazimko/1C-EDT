// Исполняет настоящую проверку BSL; обращения к базе выполняет сервер 1С.
Перем Проверок;
Перем Проверка;

Процедура Равно(Факт, Ожидание, Сценарий)
	Если Факт <> Ожидание Тогда
		ВызватьИсключение Сценарий + ": ожидалось " + Строка(Ожидание) + ", получено " + Строка(Факт);
	КонецЕсли;
	Проверок = Проверок + 1;
КонецПроцедуры

Проверок = 0;
Проверка = ЗагрузитьСценарий(АргументыКоманднойСтроки[0]);
Ошибки = Проверка.ОшибкиОбязательныхПолей("", Ложь);
Равно(Ошибки.Количество(), 2, "Пустой черновик требует имя и изделие");
Равно(Ошибки[0], "Заполните наименование технического листа.", "Понятное сообщение о наименовании");
Равно(Ошибки[1], "Выберите номенклатуру изделия для технического листа.", "Понятное сообщение об изделии");
Равно(Проверка.ОшибкиОбязательныхПолей("   ", Истина).Количество(), 1, "Имя из пробелов не принимается");
Равно(Проверка.ОшибкиОбязательныхПолей(Символы.Таб + Символы.ПС, Истина).Количество(), 1,
	"Имя из непечатаемых пробельных символов не принимается");
Равно(Проверка.ОшибкиОбязательныхПолей("Лобовое стекло", Ложь).Количество(), 1,
	"Одного наименования для записи недостаточно");
Равно(Проверка.ОшибкиОбязательныхПолей("", Истина).Количество(), 1,
	"Одной номенклатуры для записи недостаточно");
Равно(Проверка.ОшибкиОбязательныхПолей("Лобовое стекло", Истина).Количество(), 0,
	"Черновик с именем и действующим изделием проходит проверку");
Равно(Проверка.ОшибкиОбязательныхПолей(" Лобовое стекло ", Истина).Количество(), 0,
	"Пробелы вокруг непустого имени допустимы");
Равно(Проверка.ОшибкиОбязательныхПолей("Лобовое стекло", Истина, Истина).Количество(), 1,
	"Группа номенклатуры не является изделием");
Равно(Проверка.ОшибкиОбязательныхПолей("Лобовое стекло", Истина, Ложь, Истина).Количество(), 1,
	"Помеченное на удаление изделие не принимается");
Равно(Проверка.ОшибкиОбязательныхПолей("Лобовое стекло", Истина, Истина, Истина).Количество(), 2,
	"Возвращаются обе ошибки состояния изделия");
Сообщить("OK: " + Строка(Проверок) + " проверок обязательных полей техлиста");
