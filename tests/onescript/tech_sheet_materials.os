// Исполняет настоящий модуль расчёта BSL в OneScript, без платформы 1С и БД.
Перем Проверок;
Перем Расчет;

Функция Параметры()
	Возврат Новый Структура("БазовоеКоличество,Ширина,Высота,Толщина,Цвет,Припуск,ПлощадьИзделия,ПлощадьЗаготовки,Периметр,Отверстий,МатериалСтекла,ХарактеристикаСтекла,КлючСтекла",
		1, 1000, 500, 4, "green", 0, 0, 0, 0, 1, "glass", "", "glass-id/");
КонецФункции

Функция Операция(Код = "cut", ИД = "op-1")
	Возврат Новый Структура("Операция,ИД,Использовать", Код, ИД, Истина);
КонецФункции

Функция Правило(Операция = "cut", Материал = "glass", Способ = "НаИзделие", Источник = "Фиксированный", ИД = "rule-1")
	Возврат Новый Структура("ИД,Наименование,Ссылка,Операция,Источник,Способ,Номенклатура,Характеристика,КлючМатериала,Норма,Потери,ТолщинаОт,ТолщинаДо,Цвет,ВидСлоя",
		ИД, ИД, ИД, Операция, Источник, Способ, Материал, "", Материал + "-id/", 1, 0, 0, 0, "", "");
КонецФункции

Функция Слой(ИД, Материал, Процент, ВидСлоя)
	Возврат Новый Структура("ИД,Материал,Характеристика,КлючМатериала,Процент,ВидСлоя,Использовать",
		ИД, Материал, "", Материал + "-id/", Процент, ВидСлоя, Истина);
КонецФункции

Функция Коннектор(ИД, Материал, Количество)
	Возврат Новый Структура("ИД,Номенклатура,Характеристика,КлючМатериала,Количество",
		ИД, Материал, "", Материал + "-id/", Количество);
КонецФункции

Функция МассивИз(Первый, Второй = Неопределено)
	Массив = Новый Массив;
	Массив.Добавить(Первый);
	Если Второй <> Неопределено Тогда Массив.Добавить(Второй); КонецЕсли;
	Возврат Массив;
КонецФункции

Функция ВыполнитьРасчет(П, О, ПР, Слои = Неопределено, Коннекторы = Неопределено, Старые = Неопределено)
	Если Слои = Неопределено Тогда Слои = Новый Массив; КонецЕсли;
	Если Коннекторы = Неопределено Тогда Коннекторы = Новый Массив; КонецЕсли;
	Если Старые = Неопределено Тогда Старые = Новый Массив; КонецЕсли;
	Возврат Расчет.Рассчитать(П, О, ПР, Слои, Коннекторы, Старые);
КонецФункции

Процедура Равно(Факт, Ожидание, Сценарий)
	Если Факт <> Ожидание Тогда
		ВызватьИсключение Сценарий + ": ожидалось " + Строка(Ожидание) + ", получено " + Строка(Факт);
	КонецЕсли;
	Проверок = Проверок + 1;
КонецПроцедуры

Процедура ПроверитьРасходИГеометрию()
	П = Параметры();
	П.БазовоеКоличество = 10;
	Пр = Правило();
	Пр.Норма = 2;
	Р = ВыполнитьРасчет(П, МассивИз(Операция()), МассивИз(Пр));
	Равно(Р.Материалы[0].Количество, 20, "Норма на базовый выпуск, без повторного умножения на заказ");
	Равно(Р.Ошибки.Количество(), 0, "Корректный расход");
	П = Параметры();
	П.Припуск = 0.5;
	Пр = Правило("cut", "glass", "НаПлощадьЗаготовки", "Стекло");
	Пр.Потери = 10;
	Р = ВыполнитьРасчет(П, МассивИз(Операция()), МассивИз(Пр));
	Равно(Р.Материалы[0].Количество, 0.551651, "Площадь в м2, припуск на обе стороны и 10 процентов потерь");
	П.ПлощадьЗаготовки = 0.6;
	Р = ВыполнитьРасчет(П, МассивИз(Операция()), МассивИз(Пр));
	Равно(Р.Материалы[0].Количество, 0.66, "Явная площадь по раскрою имеет приоритет");
	П.ПлощадьЗаготовки = 0; П.Ширина = 0;
	Р = ВыполнитьРасчет(П, МассивИз(Операция()), МассивИз(Пр));
	Равно(Р.Материалы.Количество(), 0, "Припуск не превращает отсутствующий габарит в допустимый материал");
	Равно(Р.Ошибки.Количество() > 0, Истина, "Пустой размер выявлен");
	П = Параметры();
	Пр = Правило("cut", "tool", "НаПериметр");
	Р = ВыполнитьРасчет(П, МассивИз(Операция()), МассивИз(Пр));
	Равно(Р.Материалы[0].Количество, 3, "Периметр из мм в метры");
	П.Периметр = 2.7;
	Р = ВыполнитьРасчет(П, МассивИз(Операция()), МассивИз(Пр));
	Равно(Р.Материалы[0].Количество, 2.7, "Периметр по контуру");
КонецПроцедуры

Процедура ПроверитьКоннекторыИПечать()
	П = Параметры(); П.БазовоеКоличество = 10;
	К = МассивИз(Коннектор("c1", "subaru", 2), Коннектор("c2", "clip", 3));
	Пр = Правило("solder", "", "НаКоннектор", "Коннектор");
	Р = ВыполнитьРасчет(П, МассивИз(Операция("solder")), МассивИз(Пр), , К);
	Равно(Р.Материалы[0].Количество, 20, "Коннектор Subaru из выбранной строки");
	Равно(Р.Материалы[1].Количество, 30, "Второй тип коннектора");
	Пр = Правило("solder", "flux", "НаКоннектор"); Пр.Норма = 0.1;
	Р = ВыполнитьРасчет(П, МассивИз(Операция("solder")), МассивИз(Пр), , К);
	Равно(Р.Материалы[0].Количество, 5, "Флюс по суммарному количеству коннекторов");
	П = Параметры();
	С = МассивИз(Слой("s1", "black", 50, "Шелкография"), Слой("s2", "paste", 100, "Электрообогрев"));
	Пр = Правило("print", "", "НаПлощадьПечати", "Краска"); Пр.Норма = 0.2;
	Р = ВыполнитьРасчет(П, МассивИз(Операция("print")), МассивИз(Пр), С);
	Равно(Р.Материалы[0].Количество, 0.05, "Краска, площадь и 50 процентов нанесения");
	Равно(Р.Материалы[1].Количество, 0.1, "Паста другого слоя");
	Пр.ВидСлоя = "Электрообогрев";
	Р = ВыполнитьРасчет(П, МассивИз(Операция("print")), МассивИз(Пр), С);
	Равно(Р.Материалы.Количество(), 1, "Отбор по виду слоя");
	Равно(Р.Материалы[0].Номенклатура, "paste", "Материал соответствует выбранному слою");
	С[1].Процент = 101;
	Р = ВыполнитьРасчет(П, МассивИз(Операция("print")), МассивИз(Пр), С);
	Равно(Р.Ошибки.Количество() > 0, Истина, "Недопустимый процент нанесения");
КонецПроцедуры

Процедура ПроверитьПовторныйРасчет()
	П = Параметры(); Пр = Правило();
	О = МассивИз(Операция());
	Р1 = ВыполнитьРасчет(П, О, МассивИз(Пр));
	Р2 = ВыполнитьРасчет(П, О, МассивИз(Пр), , , Р1.Материалы);
	Равно(Р2.Материалы.Количество(), 1, "Повторный расчёт без дублей");
	Равно(Р2.Материалы[0].Количество, 1, "Повторный расчёт не накапливает расход");
	Р1.Материалы[0].Корректировка = 0.2;
	Пр.Норма = 2;
	Р2 = ВыполнитьРасчет(П, О, МассивИз(Пр), , , Р1.Материалы);
	Равно(Р2.Материалы[0].Количество, 2.2, "Ручная корректировка сохраняется при пересчёте основы");
	Пр.Номенклатура = "other"; Пр.КлючМатериала = "other-id/";
	Р2 = ВыполнитьРасчет(П, О, МассивИз(Пр), , , Р1.Материалы);
	Равно(Р2.Материалы[0].Количество, 2, "Корректировка не переносится на другой материал");
	Ручная = Новый Структура("Номенклатура,Характеристика,КлючМатериала,Количество,Автоматически", "manual", "", "manual-id/", 7, Ложь);
	Старые = МассивИз(Р1.Материалы[0], Ручная);
	О[0].Использовать = Ложь;
	Р2 = ВыполнитьРасчет(П, О, МассивИз(Пр), , , Старые);
	Равно(Р2.Материалы.Количество(), 1, "Удаляется только автоматическая потребность выключенной операции");
	Равно(Р2.Материалы[0].Количество, 7, "Ручная строка сохраняется");
	Равно(Старые.Количество(), 2, "Входные данные не изменены");
КонецПроцедуры

Процедура ПроверитьУсловияИСводныйСостав()
	П = Параметры();
	Пр = Правило(); Пр.ТолщинаОт = 5;
	Р = ВыполнитьРасчет(П, МассивИз(Операция()), МассивИз(Пр));
	Равно(Р.Материалы.Количество(), 0, "Условие по толщине");
	Пр.ТолщинаОт = 0; Пр.Цвет = "blue";
	Р = ВыполнитьРасчет(П, МассивИз(Операция()), МассивИз(Пр));
	Равно(Р.Материалы.Количество(), 0, "Условие по цвету");
	Пр.Цвет = "green";
	О = МассивИз(Операция("cut", "op1"), Операция("cut", "op2"));
	Р = ВыполнитьРасчет(П, О, МассивИз(Пр));
	Равно(Р.Материалы.Количество(), 2, "Две самостоятельные операции одного вида");
	Сводный = Расчет.СводныйСостав(Р.Материалы);
	Равно(Сводный.Количество(), 1, "Сводный состав объединяет одинаковый материал");
	Равно(Сводный[0].Количество, 2, "Расход обеих операций суммируется");
	О[1].ИД = "op1";
	Р = ВыполнитьРасчет(П, О, МассивИз(Пр));
	Равно(Р.Ошибки.Количество() > 0, Истина, "Дубли идентификаторов выявляются");
	Равно(Р.Материалы.Количество(), 1, "Повреждённые идентификаторы не удваивают расход");
	П.БазовоеКоличество = 0;
	Р = ВыполнитьРасчет(П, О, МассивИз(Пр));
	Равно(Р.Ошибки.Количество() > 0, Истина, "Нулевой базовый выпуск запрещён");
КонецПроцедуры

Процедура ПроверитьПрочиеНормыИОшибки()
	П = Параметры(); П.Отверстий = 3;
	Пр = Правило("cut", "drill", "НаОтверстие"); Пр.Норма = 0.1;
	Р = ВыполнитьРасчет(П, МассивИз(Операция()), МассивИз(Пр));
	Равно(Р.Материалы[0].Количество, 0.3, "Расход на отверстие");
	С = МассивИз(Слой("s1", "ink", 50, "Шелкография"), Слой("s2", "paste", 100, "Электрообогрев"));
	Пр = Правило("cut", "solvent", "НаСлой"); Пр.Норма = 0.1;
	Р = ВыполнитьРасчет(П, МассивИз(Операция()), МассивИз(Пр), С);
	Равно(Р.Материалы[0].Количество, 0.2, "Фиксированный материал на каждый слой");
	Пр.Способ = "НаПлощадьПечати"; Пр.Норма = 0.2;
	Р = ВыполнитьРасчет(П, МассивИз(Операция()), МассивИз(Пр), С);
	Равно(Р.Материалы[0].Количество, 0.15, "Суммарная площадь нанесения нескольких слоёв");
	С[1].Процент = 101;
	Р = ВыполнитьРасчет(П, МассивИз(Операция()), МассивИз(Пр), С);
	Равно(Р.Материалы.Количество(), 0, "Неверный процент блокирует и фиксированный расход");
	Пр = Правило("cut", "", "НаИзделие", "Коннектор");
	Р = ВыполнитьРасчет(П, МассивИз(Операция()), МассивИз(Пр), , МассивИз(Коннектор("c1", "plug", 2)));
	Равно(Р.Ошибки.Количество() > 0, Истина, "Количество коннекторов нельзя потерять выбором расчёта на изделие");
	Пр = Правило();
	Р = ВыполнитьРасчет(П, МассивИз(Операция()), МассивИз(Пр));
	Р.Материалы[0].Корректировка = -2;
	Повтор = ВыполнитьРасчет(П, МассивИз(Операция()), МассивИз(Пр), , , Р.Материалы);
	Равно(Повтор.Ошибки.Количество() > 0, Истина, "Корректировка не может сделать норму отрицательной");
	Пр.Источник = "Стекло"; П.КлючСтекла = "";
	Р = ВыполнитьРасчет(П, МассивИз(Операция()), МассивИз(Пр));
	Равно(Р.Ошибки.Количество() > 0, Истина, "Не задана номенклатура стекла-заготовки");
	Пр = Правило(); Пр.Норма = 0.000001; Пр.Способ = "НаПлощадьИзделия";
	П.Ширина = 1; П.Высота = 1; П.ПлощадьИзделия = 0;
	Р = ВыполнитьРасчет(П, МассивИз(Операция()), МассивИз(Пр));
	Равно(Р.Ошибки.Количество() > 0, Истина, "Малый расход не исчезает молча при округлении");
КонецПроцедуры

Проверок = 0;
Путь = АргументыКоманднойСтроки[0];
Расчет = ЗагрузитьСценарий(Путь);
ПроверитьРасходИГеометрию();
ПроверитьКоннекторыИПечать();
ПроверитьПовторныйРасчет();
ПроверитьУсловияИСводныйСостав();
ПроверитьПрочиеНормыИОшибки();
Сообщить("OK: " + Строка(Проверок) + " проверок расчёта материалов BSL");
