Перем Проверок;
Перем МодульСостава;

Процедура Равно(Факт, Ожидание, Сценарий)
	Если Факт <> Ожидание Тогда
		ВызватьИсключение Сценарий + ": ожидалось " + Строка(Ожидание) + ", получено " + Строка(Факт);
	КонецЕсли;
	Проверок = Проверок + 1;
КонецПроцедуры

Функция МассивИз(Элемент)
	Массив = Новый Массив; Массив.Добавить(Элемент); Возврат Массив;
КонецФункции

Функция СтараяСтрока(Ключ, Авто = Истина, Снимок = "state", Измененный = Ложь)
	Возврат Новый Структура("Ключ,Автоматически,ТекущийСнимок,СохраненныйСнимок,Строка", Ключ, Авто,
		?(Измененный, "changed", Снимок), Снимок, "row-" + Ключ);
КонецФункции

Функция НоваяСтрока(Ключ)
	Возврат Новый Структура("Ключ,Данные", Ключ, Новый Структура("Количество", 2));
КонецФункции

Проверок = 0;
МодульСостава = ЗагрузитьСценарий(АргументыКоманднойСтроки[0]);

Норма = МодульСостава.НормаДляУНФ(0.000001, 1);
Равно(Норма.Количество, 0.001, "Малая норма не округляется в ноль");
Равно(Норма.КоличествоПродукции, 1000, "Масштабируется и количество выпуска");
Норма = МодульСостава.НормаДляУНФ(0.25, 10);
Равно(Норма.Количество, 0.25, "Норма остаётся на исходную базу");
Равно(Норма.КоличествоПродукции, 10, "Нет повторного умножения на выпуск");
Норма = МодульСостава.НормаДляУНФ(0.001, 0.000001);
Равно(Норма.Количество, 1, "Дробная база масштабируется вместе с материалом");
Равно(Норма.КоличествоПродукции, 0.001, "Дробная база сохранена точно");
Норма = МодульСостава.НормаДляУНФ(1.234567, 60, 9999999.999);
Равно(Норма.Количество, 1234.567, "Минуты переводятся в часы нормой на партию");
Равно(Норма.КоличествоПродукции, 60000, "Точная база нормы времени, 60 минут в часе");
Операция = МодульСостава.НормаОперацииДляУНФ(1.234567);
Равно(Операция.Количество / Операция.КоличествоПродукции, 1, "Масштабирование времени сохраняет число операций на изделие");
Равно(Операция.НормаВремени * 60 / Операция.КоличествоПродукции, 1.234567, "Минуты на изделие сохранены без округления");
Ошибка = Ложь;
Попытка
	МодульСостава.НормаДляУНФ(1, 0);
Исключение
	Ошибка = Истина;
КонецПопытки;
Равно(Ошибка, Истина, "Нулевая база не допускается");
Ошибка = Ложь;
Попытка
	МодульСостава.НормаДляУНФ(10000000, 60, 9999999.999);
Исключение
	Ошибка = Истина;
КонецПопытки;
Равно(Ошибка, Истина, "Переполнение нормы времени УНФ выявляется");

Старые = МассивИз(СтараяСтрока("manual", Ложь));
План = МодульСостава.ПланСинхронизации(Старые, МассивИз(НоваяСтрока("auto")));
Равно(План.Добавить.Количество(), 1, "Добавляется материал операции");
Равно(План.Удалить.Количество(), 0, "Ручная строка с тем же материалом не удаляется");
Старые.Добавить(СтараяСтрока("auto"));
План = МодульСостава.ПланСинхронизации(Старые, МассивИз(НоваяСтрока("auto")));
Равно(План.Добавить.Количество(), 0, "Повторное заполнение без дублей");
Равно(План.Обновить.Количество(), 1, "Обновляется прежняя автоматическая строка");
План = МодульСостава.ПланСинхронизации(Старые, Новый Массив);
Равно(План.Удалить.Количество(), 1, "Удаляется потребность снятой операции");
Равно(План.Удалить[0], "row-auto", "Удаляется только строка собственного источника");
Равно(Старые.Количество(), 2, "Входные строки не меняются до проверки плана");
Старые[1] = СтараяСтрока("auto", Истина, "state", Истина);
План = МодульСостава.ПланСинхронизации(Старые, МассивИз(НоваяСтрока("auto")));
Равно(План.Ошибки.Количество() > 0, Истина, "Ручное изменение автоматической нормы не затирается молча");
Старые[1] = СтараяСтрока("auto"); Старые.Добавить(СтараяСтрока("auto"));
План = МодульСостава.ПланСинхронизации(Старые, МассивИз(НоваяСтрока("auto")));
Равно(План.Ошибки.Количество() > 0, Истина, "Копирование автоматической строки выявляется");
Новые = МассивИз(НоваяСтрока("auto")); Новые.Добавить(НоваяСтрока("auto"));
План = МодульСостава.ПланСинхронизации(Новый Массив, Новые);
Равно(План.Ошибки.Количество() > 0, Истина, "Повтор источника в новом плане выявляется до изменения строк");
План = МодульСостава.ПланСинхронизации(МассивИз(СтараяСтрока("auto", Истина, "")), Новый Массив);
Равно(План.Ошибки.Количество() > 0, Истина, "Отсутствие контрольного снимка не разрешает удаление");
Сообщить("OK: " + Строка(Проверок) + " проверок интеграции состава BSL");
